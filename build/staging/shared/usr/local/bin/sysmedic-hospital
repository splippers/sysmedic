#!/usr/bin/env python3
"""sysmedic-hospital — talk to the hospital: the engineer's Claude on the build PC, over the LAN.

This rescue computer is the ambulance. It sends redacted questions and findings and reads the replies. It is a
mailbox: the hospital can't run anything here. Advice that comes back is read by you (and the AI assistant); the
normal safety rules still decide what is allowed to run.

  sysmedic-hospital pair             engineer only: paste the pairing code made by `hospital pair NAME` on the build PC
  sysmedic-hospital join CODE|PIN [HOST]  engineer only: the short way in (the swarm code: swarm only; a 6-digit PIN from `hospital pin`: full pairing). Finds the hospital itself, names this computer by its Service Tag
  sysmedic-hospital unpair           forget the hospital
  sysmedic-hospital status           paired? reachable?
  sysmedic-hospital send [-k question|finding|status] TEXT      send (TEXT or - for stdin); cleaned by sysmedic-redact first
  sysmedic-hospital read [--wait SECONDS]                       print new replies (optionally wait for one)
  sysmedic-hospital ask TEXT         send, then wait up to 3 minutes for the answer
  sysmedic-hospital swarm read [SINCE]      the open brainstorm: topic + what the other agents (named by Service Tag) said
  sysmedic-hospital swarm post [-r ID] TEXT add one contribution (-r: in reply to post ID); no customer or machine data
  sysmedic-hospital mcp              MCP server on stdio (tools post_message, read_replies, swarm_read, swarm_post):
                                     OpenCode starts this itself (it is in its config); it holds the pinned connection

The connection is HTTPS pinned to the hospital's certificate fingerprint from the pairing code. The pairing code is kept
in the vault (private/), or in memory only when the vault is locked.
"""
import base64
import hashlib
import http.client
import json
import os
import ssl
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlparse

PRIV = Path(os.environ["SYSMEDIC_HOSPITAL_DIR"]) if os.environ.get("SYSMEDIC_HOSPITAL_DIR") else \
    Path("/mnt/persist/private") if Path("/mnt/persist/private").is_dir() else Path("/run/sysmedic")   # env: tests only
CONF = PRIV / "hospital.json"
CURSOR = (PRIV if os.environ.get("SYSMEDIC_HOSPITAL_DIR") else Path("/run/sysmedic")) / "hospital.cursor"


def load():
    try:
        return json.loads(CONF.read_text())
    except (OSError, ValueError):
        sys.exit("  Not paired with a hospital. The engineer pairs it: sysmedic-hospital pair (Alt+F2).")


def call(method, path, body=None, timeout=20):
    c = load()
    u = urlparse(c["u"])
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE
    conn = http.client.HTTPSConnection(u.hostname, u.port or 443, context=ctx, timeout=timeout)
    try:
        conn.connect()
        got = hashlib.sha256(conn.sock.getpeercert(binary_form=True)).hexdigest()
        if got != c["f"]:
            sys.exit("  The hospital's certificate is not the one that was paired: refusing to talk to it.")
        conn.request(method, path, json.dumps(body) if body is not None else None,
                     {"Authorization": "Bearer " + c["t"], "Content-Type": "application/json"})
        r = conn.getresponse()
        data = r.read()
        return r.status, (json.loads(data) if data else {})
    except (OSError, ssl.SSLError) as e:
        sys.exit(f"  Can't reach the hospital ({u.hostname}): {e}. Is this computer on the same network?")
    finally:
        conn.close()


def redact(text):
    if not Path("/usr/local/bin/sysmedic-redact").exists():
        return text
    r = subprocess.run(["/usr/local/bin/sysmedic-redact"], input=text, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 and r.stdout.strip() else text


def device_line():
    try:
        s = json.loads(Path("/run/sysmedic/latest/scan.json").read_text())["system"]
        tag = s.get("serial") or ""
        return f"[{s.get('manufacturer', '')} {s.get('model', '')} · Service Tag {tag} · SysMedic {s.get('sysmedic_version', '')}]".replace("  ", " ")
    except (OSError, ValueError, KeyError):
        return ""


def cmd_pair(_):
    if os.environ.get("SYSMEDIC_AI"):
        sys.exit("  Pairing is for the engineer: run it yourself on console 2 (Alt+F2). The AI can't pair.")
    code = (sys.argv[2] if len(sys.argv) > 2 else input("  PIN or pairing code (H1.…): ")).strip()
    if not code.startswith("H1."):                       # a short PIN / join code typed here: that is the join command
        sys.argv[2:3] = [code]
        return cmd_join(_)
    try:
        d = json.loads(base64.urlsafe_b64decode(code[3:] + "=" * (-len(code[3:]) % 4)))
        assert code.startswith("H1.") and d["u"].startswith("https://") and d["f"] and d["t"]
    except Exception:  # noqa: BLE001
        sys.exit("  That isn't a pairing code (it starts H1.).")
    PRIV.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps({"u": d["u"], "f": d["f"], "t": d["t"], "n": d.get("n", "")}))
    os.chmod(CONF, 0o600)
    CURSOR.unlink(missing_ok=True)
    code, body = call("GET", "/api/replies?since=0")
    print(f"  Paired as '{d.get('n', '')}'." if code == 200 else f"  Saved, but the hospital said {code}: {body}")
    print("  Kept in the vault." if str(PRIV) != "/run/sysmedic" else "  Vault locked: kept in memory only; pair again next boot.")


def service_tag():
    try:
        t = json.loads(Path("/run/sysmedic/latest/scan.json").read_text())["system"].get("serial") or ""
    except (OSError, ValueError, KeyError):
        t = ""
    if not t:
        t = subprocess.run(["dmidecode", "-s", "system-serial-number"], capture_output=True, text=True).stdout.strip()
    t = "".join(c if c.isalnum() or c in "-_" else "-" for c in t.strip())[:32]
    return t if t and t.lower() not in ("none", "default-string", "to-be-filled-by-o-e-m") else ""


def find_hospital():
    """The hospital is on this private network: look for it on this machine's /24 (port 8470)."""
    import socket
    import concurrent.futures as cf
    nets = {".".join(l.split()[3].split("/")[0].split(".")[:3]) for l in
            subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], capture_output=True, text=True).stdout.splitlines()}

    def probe(ip):
        try:
            with socket.create_connection((ip, 8470), timeout=0.4):
                return ip
        except OSError:
            return None
    with cf.ThreadPoolExecutor(64) as ex:
        for ip in ex.map(probe, [f"{n}.{i}" for n in sorted(nets) for i in range(1, 255)]):
            if ip:
                return ip
    return None


def cmd_join(_):
    """join CODE [HOST] [NAME] — the short way in, for the swarm only (private network; the engineer chose the code)."""
    if os.environ.get("SYSMEDIC_AI"):
        sys.exit("  Joining is for the engineer: run it yourself on console 2 (Alt+F2). The AI can't join.")
    args = [x for x in sys.argv[2:] if not x.startswith("-")]
    code = args[0] if args else input("  Join code: ").strip()
    host = args[1] if len(args) > 1 else None
    name = args[2] if len(args) > 2 else service_tag() or input("  Name for this computer (no Service Tag found): ").strip()
    if not host:
        print("  Looking for the hospital on this network…", flush=True)
        host = find_hospital()
        if not host:
            sys.exit("  Didn't find it. Is this computer on the same network? Or: sysmedic-hospital join CODE HOST_IP")
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE        # first meeting: the fingerprint is taken from this connection and pinned
    conn = http.client.HTTPSConnection(host, 8470, timeout=15, context=ctx)
    try:
        conn.request("POST", "/api/join", json.dumps({"code": code, "name": name}), {"Content-Type": "application/json"})
        fp = hashlib.sha256(conn.sock.getpeercert(True)).hexdigest()
        r = conn.getresponse()
        body = json.loads(r.read() or b"{}")
    except (OSError, ValueError) as e:
        sys.exit(f"  Can't reach the hospital at {host}: {e}")
    finally:
        conn.close()
    if r.status != 200:
        sys.exit(f"  Not joined: {body.get('error', r.status)}")
    PRIV.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps({"u": f"https://{host}:8470", "f": fp, "t": body["token"], "n": body["name"], "scope": body.get("scope", "swarm")}))
    os.chmod(CONF, 0o600)
    print(f"  Joined ({body.get('scope', 'swarm')}) as '{body['name']}' ({host}).")
    print("  Kept in the vault." if str(PRIV) != "/run/sysmedic" else "  Vault locked: kept in memory only; join again next boot.")


def cmd_unpair(_):
    CONF.unlink(missing_ok=True)
    print("  Forgotten.")


def cmd_status(_):
    c = load()
    code, _ = call("GET", "/api/replies?since=999999999")
    print(f"  Paired as '{c.get('n', '')}' with {c['u']}: " + ("reachable." if code == 200 else f"answered {code}."))


def cmd_send(a):
    kind = "question"
    if a[:1] == ["-k"]:
        kind, a = a[1], a[2:]
    text = sys.stdin.read() if a == ["-"] else " ".join(a)
    if not text.strip():
        sys.exit("usage: sysmedic-hospital send [-k kind] TEXT")
    body = (device_line() + "\n" if device_line() else "") + redact(text).strip()
    code, r = call("POST", "/api/post", {"text": body, "kind": kind})
    if code != 200:
        sys.exit(f"  The hospital refused it: {r.get('error', code)}")
    print(f"  Sent (#{r['id']}). Read the answer with: sysmedic-hospital read --wait 120")


def cmd_read(a):
    wait = int(a[a.index("--wait") + 1]) if "--wait" in a else 0
    end = time.time() + wait
    while True:
        try:
            since = int(CURSOR.read_text())
        except (OSError, ValueError):
            since = 0
        code, r = call("GET", f"/api/replies?since={since}")
        rep = r.get("replies", []) if code == 200 else []
        if rep:
            for m in rep:
                print(f"── hospital reply #{m['id']} · {m['ts']}\n{m['text']}\n")
            CURSOR.parent.mkdir(parents=True, exist_ok=True)
            CURSOR.write_text(str(rep[-1]["id"]))
            print("(Advice only: your safety rules and the engineer still decide what runs.)")
            return
        if time.time() >= end:
            print("  No new replies.")
            return
        time.sleep(3)


def cmd_swarm(a):
    if a[:1] == ["read"]:
        code, r = call("GET", f"/api/swarm?since={a[1] if len(a) > 1 else 0}")
        if code != 200 or not r.get("topic"):
            return print("  " + (r.get("note") or r.get("error") or f"hospital said {code}"))
        t = r["topic"]
        print(f"# {t['title']}\n{t['brief']}\n(you are {r['you_are']}; {r['posts_left_for_you']} contributions left)\n")
        for m in r["posts"]:
            print(f"#{m['id']} {m['from']}" + (f" → re #{m['reply_to']}" if m["reply_to"] else "") + f"\n{m['text']}\n")
    elif a[:1] == ["post"]:
        a = a[1:]
        reply = 0
        if a[:1] == ["-r"]:
            reply, a = int(a[1]), a[2:]
        text = sys.stdin.read() if a == ["-"] else " ".join(a)
        code, r = call("POST", "/api/swarm/post", {"text": redact(text).strip(), "reply_to": reply})
        print(f"  Posted (#{r['id']})." if code == 200 else f"  Not posted: {r.get('error', code)}")
    else:
        sys.exit("usage: sysmedic-hospital swarm read [SINCE] | swarm post [-r ID] TEXT")


OFFLINE_TOOLS = [
    {"name": n, "description": d, "inputSchema": {"type": "object", "properties": pr}} for n, d, pr in [
        ("post_message", "Send a redacted question, finding or status to the hospital.", {"text": {"type": "string"}, "kind": {"type": "string"}}),
        ("read_replies", "Read the hospital's replies to this machine.", {"since_id": {"type": "integer"}}),
        ("swarm_read", "Read the open brainstorm (other agents' ideas, by Service Tag).", {"since_id": {"type": "integer"}, "wait_seconds": {"type": "integer"}}),
        ("swarm_post", "Add one contribution to the open brainstorm.", {"text": {"type": "string"}, "reply_to": {"type": "integer"}})]]


def offline_reply(req, why):
    """Not paired or hospital unreachable: still be a valid MCP server, so the AI sees the tools and a clear reason
    (a server that fails to start leaves the tools missing, and the AI can't tell why)."""
    i, m = req.get("id"), req.get("method")
    if i is None:
        return None
    if m == "initialize":
        r = {"protocolVersion": "2025-03-26", "capabilities": {"tools": {}}, "serverInfo": {"name": "sysmedic-hospital", "version": "1"}}
    elif m == "tools/list":
        r = {"tools": OFFLINE_TOOLS}
    elif m == "tools/call":
        r = {"content": [{"type": "text", "text": why}], "isError": True}
    else:
        return {"jsonrpc": "2.0", "id": i, "error": {"code": -32601, "message": why}}
    return {"jsonrpc": "2.0", "id": i, "result": r}


def cmd_mcp(_):
    """Stdio MCP bridge: each JSON-RPC line goes to the hospital's /mcp over the pinned connection."""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except ValueError:
            continue
        if req.get("method") == "tools/call":                 # contributions are cleaned here too
            a = req.get("params", {}).get("arguments", {})
            if isinstance(a.get("text"), str):
                a["text"] = redact(a["text"]).strip()
        try:
            code, resp = call("POST", "/mcp", req, timeout=30)
        except SystemExit as e:
            resp = offline_reply(req, str(e).strip())
            code = 200
        if resp and req.get("id") is not None:
            print(json.dumps(resp), flush=True)


def cmd_ask(a):
    cmd_send(a)
    cmd_read(["--wait", "180"])


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    fn = globals().get("cmd_" + sys.argv[1])
    if not fn:
        sys.exit(__doc__)
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()
