#!/usr/bin/env python3
"""sysmedic-announce — let the phone app find this visit (mDNS). Off by default; private hotspot only.

  sysmedic-announce [ADDRESS]   announce on ADDRESS (default: the private hotspot, 10.42.0.1); Ctrl-C to stop
  sysmedic-announce --show      print what would be announced, and send nothing

It answers mDNS questions for _sysmedic._tcp and announces itself once at start and when asked. It never listens
for or reads anything else. See lib/sysmedic/announce.py for exactly what is said (no code, no customer data).
"""
import os
import socket
import struct
import sys
import time

sys.path.insert(0, "/usr/local/lib/sysmedic")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib/sysmedic"))
import announce  # noqa: E402

HOTSPOT_ADDR = "10.42.0.1"
GROUP, MPORT = "224.0.0.251", 5353


def read(path, default=""):
    try:
        return open(path).read().strip()
    except OSError:
        return default


def records_for(address):
    machine = read("/etc/machine-id", "000000")
    state = "scanned" if os.path.exists("/run/sysmedic/latest/scan.json") else "ready"
    return announce.service_records(announce.visit_name(machine), announce.visit_name(machine).lower(), address,
                                   "lite" if os.path.exists("/etc/sysmedic/lite") else read("/etc/sysmedic/edition", "dev"), read("/etc/sysmedic/version", "dev"), state)


def main():
    args = sys.argv[1:]
    address = next((a for a in args if not a.startswith("-")), HOTSPOT_ADDR)
    if "--show" in args:
        for r in records_for(address):
            print(r.hex())
        print(f"would announce on {address} (not sent)")
        return
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind(("", MPORT))
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, socket.inet_aton(GROUP) + socket.inet_aton(address))
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(address))
    except OSError as e:
        sys.exit(f"Cannot announce on {address}: {e} (is the private hotspot on? sysmedic-hotspot on)")
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)         # never beyond this link
    reply = lambda: announce.response(records_for(address))                # noqa: E731  (state can change)
    sock.sendto(reply(), (GROUP, MPORT))
    print(f"announcing {announce.SERVICE} on {address} (Ctrl-C to stop)")
    last = 0.0
    while True:
        data, peer = sock.recvfrom(9000)
        if announce.wants(announce.questions(data)) and time.time() - last > 1:      # rate-limit: one answer a second
            last = time.time()
            sock.sendto(reply(), (GROUP, MPORT))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
