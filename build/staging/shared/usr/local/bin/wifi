#!/bin/bash
# SysMedic Wi-Fi: NetworkManager's on-screen network picker (arrow keys, Enter, Esc to leave).
nmcli radio wifi on >/dev/null 2>&1
guide=$(python3 -c 'import sys; sys.path.insert(0, "/usr/local/lib/sysmedic"); import wifiguide; wifiguide.show()' 2>/dev/null)
if [ -n "$guide" ] && [ -t 0 ]; then
    echo ""; echo "$guide"; echo ""
    read -r -p "  Press Enter to choose a network… " _
    [ -z "${SYSMEDIC_AI:-}" ] && python3 /usr/local/lib/sysmedic/wifiguide.py --reserve 2>/dev/null
fi
nmtui connect "$@"
echo ""
nmcli -f DEVICE,TYPE,STATE,CONNECTION device | grep -E 'DEVICE|wifi|ethernet'
ip -4 -br addr | grep -v '^lo'
# Once online, correct SysMedic's clock if it's wrong (secure connections fail otherwise); a no-op offline
/usr/local/bin/sysmedic-clock --auto 2>/dev/null || true
# Joined a Wi-Fi network: offer to remember it in the encrypted vault (asks; never saved otherwise)
[ -z "${SYSMEDIC_AI:-}" ] && /usr/local/sbin/sysmedic-vault networks offer
