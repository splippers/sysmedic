#!/usr/bin/env python3
r"""sysmedic-win — Windows rescue toolkit (works on the offline installation).

Read-only (safe for the AI to run):
  sysmedic-win                      list Windows installations and BitLocker volumes
  sysmedic-win info     [PART]      version, Fast Startup, last shutdown, accounts, WinRE, pending reboots
  sysmedic-win crashes  [PART]      blue-screen stop codes decoded, with what they usually mean
  sysmedic-win events   [PART]      crashes, power loss, disk/hardware errors, failed services from the System log
  sysmedic-win autoruns [PART]      everything that starts automatically, with suspicious entries flagged
  sysmedic-win malware  [PART] [--full]   ClamAV scan of autostart files and user/program-data folders

Deep troubleshooting (read-only; PART can also be files or a folder handed over, e.g. exported logs):
  sysmedic-win evtx     [PART|FILES] [--days N] [--curated]
                                    every event log: crashes, power, disk, drivers, updates, apps, Defender,
                                    boot times, security summary, plus an error sweep of all other logs
  sysmedic-win registry [PART] [--days N]
                                    registry evidence: services/drivers with missing files, broken device
                                    filters, hijacks, protection/update policies, recent installs
  sysmedic-win cbs      [PART|CBS.log|FOLDER] [--days N]
                                    servicing: CBS/CbsPersist, dism.log, Windows Update results, upgrade
                                    (Panther) logs: failing updates, error meanings, corruption, SFC
  sysmedic-win reg      [PART] KEY [VALUE] [--depth N]
                                    read any registry key/value, read-only: HKLM\SYSTEM\CurrentControlSet\…,
                                    HKLM\SOFTWARE\Policies\… (SAM/SECURITY refused)
  sysmedic-win bcd      [ESP|BCD-FILE]  Windows boot configuration: entries, default, hypervisorlaunchtype,
                                    testsigning, safeboot, recovery (read-only)
  sysmedic-win etl      [PART|FILES|FOLDER] [--days N]
                                    ETW traces (.etl: Windows Update, waasmedic, SIH, NetSetup…): failure codes
                                    with meanings, when they happened, and decode coverage per file (default 7 days)
  sysmedic-win checkup  [PART] [--days N]
                                    all of the above plus info/crashes/autoruns, saved as a report in the
                                    session folder (windows-checkup-*.md)

Engineer only (run on a console):
  sysmedic-win bitlocker DEV        unlock a BitLocker volume with its recovery key (read-only)
  sysmedic-win bitlocker-web        let someone enter the key from a phone/laptop on the same network
                                    (HTTPS, secret QR link, read-only, stops by itself)
  sysmedic-win fix-update PART      roll back a half-installed update (renames WinSxS\\pending.xml)
  sysmedic-win fix-hibernation PART discard Windows' hibernation/Fast Startup state so the disk can be repaired
  sysmedic-win reset-password PART  blank a local account's password (chntpw)

PART is a partition like /dev/nvme0n1p3 (or an unlocked BitLocker volume
/dev/mapper/bitlocker-…). Without PART, every Windows installation is used.
Repairs need the partition unlocked first: sysmedic-unlock PART on Alt+F2.
"""
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/sysmedic")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib/sysmedic"))
import winlib  # noqa: E402
from ui import UI  # noqa: E402

def sec(title, note=""):
    """A section heading in SysMedic's style, with an optional dim note under it."""
    ui = UI()
    print(ui.section(title) + ("\n  " + ui.c("dim", note) if note else ""), flush=True)

import winevidence  # noqa: E402

RUN = Path("/run/sysmedic")
CLAMDB = Path("/mnt/persist/clamav")
COLOR = sys.stdout.isatty()
C = {k: (v if COLOR else "") for k, v in {"red": "\033[1;31m", "yel": "\033[1;33m", "grn": "\033[0;32m",
                                          "cyan": "\033[0;36m", "bold": "\033[1m", "dim": "\033[2m", "end": "\033[0m"}.items()}


def run(cmd, timeout=120, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout, **kw)
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def audit(msg):
    d = (RUN / "latest").resolve() if (RUN / "latest").exists() else RUN
    tty = os.ttyname(0).replace("/dev/", "") if os.isatty(0) else ("ai" if os.environ.get("SYSMEDIC_AI") else "script")
    with open(d / "audit.log", "a") as f:
        f.write(f"{datetime.datetime.now().astimezone().isoformat(timespec='seconds')} [{tty}] sysmedic-win: {msg}\n")


def called_by_ai():
    if os.environ.get("SYSMEDIC_AI"):
        return True
    pid = os.getpid()
    while pid > 1:
        try:
            comm = Path(f"/proc/{pid}/comm").read_text().strip()
            args = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
            pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
        if any(s in f"{comm} {args}" for s in ("opencode", "sysmedic-ask", "ollama")):
            return True
    return False


def human_only(what):
    if called_by_ai():
        audit(f"REFUSED {what}: requested by the AI assistant")
        sys.exit(f"REFUSED: '{what}' must be run by the engineer on a console (Alt+F2), not by the AI assistant.")
    if not os.isatty(0):
        sys.exit(f"REFUSED: '{what}' needs a person at a console to answer its questions.")


def is_locked(dev):
    k = os.path.basename(os.path.realpath(dev))
    try:
        return Path(f"/sys/class/block/{k}/ro").read_text().strip() == "1"
    except OSError:
        return False


# ── Finding and mounting Windows volumes ───────────────────────────────────

def ntfs_partitions():
    p = run(["lsblk", "-lnpo", "NAME,FSTYPE,MOUNTPOINTS"])
    out = []
    for line in p.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2 and parts[1] == "ntfs":
            out.append(parts[0])
    return out


def bitlocker_volumes():
    p = run(["lsblk", "-lnpo", "NAME,FSTYPE"])
    return [l.split()[0] for l in p.stdout.splitlines() if len(l.split()) == 2 and l.split()[1] == "BitLocker"]


class Mounted:
    """Context manager: mount an NTFS volume read-only (or read-write) somewhere temporary."""
    def __init__(self, dev, rw=False, extra=""):
        self.dev, self.rw, self.extra, self.path = dev, rw, extra, None

    def __enter__(self):
        existing = run(["findmnt", "-rno", "TARGET", "-S", self.dev]).stdout.split()
        if existing and not self.rw:
            self.path, self.ours = existing[0], False
            return self.path
        (RUN / "win").mkdir(parents=True, exist_ok=True)
        self.path = tempfile.mkdtemp(prefix=os.path.basename(self.dev) + "-", dir=RUN / "win")
        opts = ("rw" if self.rw else "ro") + ("," + self.extra if self.extra else "")
        p = run(["ntfs-3g", "-o", opts, self.dev, self.path])
        if p.returncode != 0:
            os.rmdir(self.path)
            raise RuntimeError((p.stderr or p.stdout).strip().splitlines()[-1] if (p.stderr or p.stdout).strip() else "mount failed")
        self.ours = True
        if self.rw and os.statvfs(self.path).f_flag & os.ST_RDONLY:
            hib = winlib.ci_path(self.path, "hiberfil.sys")
            hibernated = False
            try:
                hibernated = bool(hib) and hib.open("rb").read(4).lower() == b"hibr"
            except OSError:
                pass
            self.__exit__()
            raise RuntimeError("Windows is hibernated (Fast Startup), so the volume only mounts read-only. "
                               f"Run first: sysmedic-win fix-hibernation {self.dev}" if hibernated else
                               "the volume only mounted read-only (NTFS marked dirty or damaged — chkdsk from WinRE)")
        return self.path

    def __exit__(self, *exc):
        if self.path and getattr(self, "ours", False):
            run(["umount", self.path])
            try:
                os.rmdir(self.path)
            except OSError:
                pass


def windows_installs(part=None):
    """Yield (device, mountpoint) for each Windows system volume, mounted read-only."""
    if part and part in bitlocker_volumes():
        mapped = f"/dev/mapper/bitlocker-{os.path.basename(part)}"
        if not os.path.exists(mapped):
            sys.exit(f"{part} is BitLocker-encrypted and locked. Unlock it first (read-only): sysmedic-win bitlocker {part}, "
                     "or the BitLocker card on the phone dashboard.")
        print(f"  {C['dim']}{part} is BitLocker-encrypted; reading its unlocked copy {mapped}{C['end']}")
        part = mapped
    candidates = [part] if part else ntfs_partitions()
    for dev in candidates:
        try:
            with Mounted(dev) as mp:
                if winlib.ci_path(mp, "Windows/System32"):
                    yield dev, mp
        except RuntimeError as e:
            if part:
                sys.exit(f"Could not mount {dev} read-only: {e}")


def header(dev, mp):
    i = winlib.info(mp)
    print("\n" + UI().banner(i["name"], f"{dev}" + (f" · {i.get('computer_name')}" if i.get("computer_name") else "")))
    return i



# ── Registry and boot configuration (read-only) ───────────────────────────────

REG_HIVES = {"SYSTEM": "Windows/System32/config/SYSTEM", "SOFTWARE": "Windows/System32/config/SOFTWARE",
             "DEFAULT": "Windows/System32/config/DEFAULT"}


def reg_split(key):
    k = key.replace("/", "\\").strip("\\")
    k = re.sub(r"^(computer\\)?(hklm|hkey_local_machine)\\", "", k, flags=re.I)
    hive, _, rest = k.partition("\\")
    return hive.upper(), rest


def fmt_val(v):
    if isinstance(v, int):
        return f"{v} (0x{v:x})"
    if isinstance(v, list):
        return " | ".join(v) if v else "(empty list)"
    if isinstance(v, bytes):
        return (v[:48].hex(" ") + (" …" if len(v) > 48 else "")) if v else "(empty)"
    return v if v != "" else '""'


def cmd_reg(args):
    """sysmedic-win reg [PART] KEY [VALUE] [--depth N]: read a registry key's values and subkeys."""
    depth = opt(args, "--depth", 0)
    rest = [a for i, a in enumerate(args) if not a.startswith("--") and not (i and args[i - 1] == "--depth")]
    part = rest.pop(0) if rest and (rest[0].startswith("/dev/") or Path(rest[0]).is_dir()) else None
    if not rest:
        sys.exit("usage: sysmedic-win reg [PART] KEY [VALUE] [--depth N]\n"
                 "  e.g. sysmedic-win reg HKLM\\SYSTEM\\CurrentControlSet\\Services\\wuauserv Start\n"
                 "       sysmedic-win reg /dev/nvme0n1p3 SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate --depth 2")
    key, value = rest[0], (rest[1] if len(rest) > 1 else None)
    hive_name, path = reg_split(key)
    if hive_name in ("SAM", "SECURITY"):
        sys.exit("Refused: the SAM and SECURITY hives hold password hashes and secrets; SysMedic never reads them.")
    if hive_name not in REG_HIVES:
        sys.exit(f"Unknown hive '{hive_name}': use SYSTEM, SOFTWARE or DEFAULT (HKLM\\SYSTEM\\…, HKLM\\SOFTWARE\\…)")
    for label, root in ([("", Path(part))] if part and Path(part).is_dir() else targets([part] if part else [])):
        h = winlib.open_hive(root, REG_HIVES[hive_name])
        if not h:
            print(f"  {C['yel']}Can't open the {hive_name} hive{C['end']}")
            continue
        p = path
        if hive_name == "SYSTEM" and re.match(r"currentcontrolset(\\|$)", p, re.I):
            p = winlib.control_set(h) + p[len("CurrentControlSet"):]
        if not h.node(p):
            print(f"  {C['yel']}No such key: {hive_name}\\{p}{C['end']}")
            continue
        if value:
            v = h.get(p, value, None)
            if v is None:
                print(f"  {C['yel']}{hive_name}\\{p}: no value '{value}'{C['end']}")
            else:
                print(f"  {hive_name}\\{p}\\{value} = {fmt_val(v)}")
            continue

        def show(kp, level):
            print(f"  {C['bold']}{hive_name}\\{kp}{C['end']}")
            for n, v in sorted(h.values(kp).items(), key=lambda x: x[0].lower()):
                print(f"    {n or '(Default)'} = {fmt_val(v)}")
            subs = h.subkeys(kp)
            if subs and level >= depth:
                print(f"    {C['dim']}subkeys: {', '.join(subs[:60])}{' …' if len(subs) > 60 else ''}{C['end']}")
            elif level < depth:
                for sk in subs[:60]:
                    show(kp + "\\" + sk, level + 1)
        show(p, 0)


BCD_TYPES = {0x10100002: "Windows Boot Manager", 0x10200003: "Windows Boot Loader", 0x10200004: "Resume from Hibernate",
             0x10200005: "Memory Diagnostic", 0x10300006: "Legacy OS loader", 0x10400008: "Boot sector", 0x101fffff: "Firmware Boot Manager"}
BCD_WELL_KNOWN = {"{9dea862c-5cdd-4e70-acc1-f32b344d4795}": "bootmgr", "{7ea2e1ac-2e61-4728-aaa3-896d9d0a9f0e}": "globalsettings",
                  "{6efb52bf-1766-41db-a6b3-0ee5eff72bd5}": "bootloadersettings", "{7ff607e0-4395-11db-b0de-0800200c9a66}": "hypervisorsettings",
                  "{4636856e-540f-4170-a130-a84776f4c654}": "dbgsettings", "{a5a30fa2-3d06-4e9f-b5f4-a01df9d1fcba}": "fwbootmgr",
                  "{b2721d73-1db4-4c62-bf78-c548a880142d}": "memdiag", "{0ce4991b-e6b3-4b16-b23c-5e0d9250e5d9}": "emssettings",
                  "{5189b25c-5558-4bf2-bca4-289b11bd29e2}": "badmemory", "{1afa9c49-16ab-4a5c-901b-212802da9460}": "resumeloadersettings"}
BCD_ELEMENTS = {0x12000004: "description", 0x12000002: "path", 0x22000002: "systemroot", 0x23000003: "default",
                0x24000001: "displayorder", 0x24000010: "toolsdisplayorder", 0x25000004: "timeout", 0x250000f0: "hypervisorlaunchtype",
                0x16000049: "testsigning", 0x16000048: "nointegritychecks", 0x16000010: "bootdebug", 0x260000a0: "debug",
                0x25000020: "nx", 0x25000080: "safeboot", 0x16000009: "recoveryenabled", 0x14000008: "recoverysequence",
                0x250000e0: "bootstatuspolicy", 0x250000c2: "bootmenupolicy", 0x23000006: "resumeobject", 0x26000022: "winpe",
                0x21000001: "device", 0x11000001: "device", 0x22000011: "kernel", 0x250000f3: "vsmlaunchtype?",
                0x26000025: "lastknowngood", 0x12000005: "locale", 0x24000006: "displayorder(tools)"}
BCD_ENUMS = {"hypervisorlaunchtype": {0: "Off", 1: "Auto"}, "nx": {0: "OptIn", 1: "OptOut", 2: "AlwaysOff", 3: "AlwaysOn"},
             "safeboot": {0: "Minimal", 1: "Network", 2: "DsRepair"}, "bootstatuspolicy": {0: "DisplayAllFailures", 1: "IgnoreAllFailures",
             2: "IgnoreShutdownFailures", 3: "IgnoreBootFailures"}, "bootmenupolicy": {0: "Legacy", 1: "Standard"}}
BCD_WARN = {"testsigning": "test-signed drivers allowed (security risk; often left by driver tools)",
            "nointegritychecks": "driver signature checks OFF (security risk)", "safeboot": "Windows will keep booting into Safe Mode",
            "bootdebug": "boot debugging on", "debug": "kernel debugging on (slow, unusual)"}


def esp_partitions():
    p = run(["lsblk", "-lnpo", "NAME,PARTTYPENAME"])
    return [l.split()[0] for l in p.stdout.splitlines() if "EFI System" in l]


def bcd_read(path):
    h = winlib.Hive(path)
    entries = []
    for g in h.subkeys("Objects"):
        typ = h.get(f"Objects\\{g}\\Description", "Type", 0)
        els = {}
        for e in h.subkeys(f"Objects\\{g}\\Elements"):
            try:
                eid = int(e, 16)
            except ValueError:
                continue
            v = h.get(f"Objects\\{g}\\Elements\\{e}", "Element")
            fmt = (eid >> 24) & 0xF
            if isinstance(v, bytes):
                if fmt == 6:
                    v = bool(v[0]) if v else False
                elif fmt == 5 and len(v) >= 8:
                    v = int.from_bytes(v[:8], "little")
                elif fmt == 1:
                    v = "(device)"
            name = BCD_ELEMENTS.get(eid, f"0x{eid:08x}")
            if name in BCD_ENUMS and isinstance(v, int):
                v = BCD_ENUMS[name].get(v, v)
            els[name] = v
        entries.append({"guid": g.lower(), "type": BCD_TYPES.get(typ, f"0x{typ:08x}" if isinstance(typ, int) else "?"), "el": els})
    return entries


def cmd_bcd(args):
    """sysmedic-win bcd [ESP-PARTITION|BCD-FILE]: Windows boot configuration, read-only."""
    given = [a for a in args if not a.startswith("--")]
    files = []
    if given and Path(given[0]).is_file():
        files = [(given[0], Path(given[0]))]
    devs = [] if files else ([given[0]] if given else esp_partitions())
    mounts = []
    try:
        for d in devs:
            mp = tempfile.mkdtemp(prefix="sysmedic-esp-")
            if run(["mount", "-o", "ro", d, mp]).returncode != 0:
                os.rmdir(mp)
                continue
            mounts.append(mp)
            f = winlib.ci_path(mp, "EFI/Microsoft/Boot/BCD")
            if f:
                files.append((d, Path(f)))
        if not files:
            print(f"  {C['yel']}No Windows boot configuration (EFI/Microsoft/Boot/BCD) found on {', '.join(devs) or 'any EFI partition'}.{C['end']}")
            return
        for src, f in files:
            try:
                entries = bcd_read(f)
            except (OSError, RuntimeError) as e:
                print(f"  {C['red']}Can't read {f}: {e}{C['end']}")
                continue
            byg = {e["guid"]: e for e in entries}
            mgr = byg.get("{9dea862c-5cdd-4e70-acc1-f32b344d4795}", {}).get("el", {})
            default = str(mgr.get("default", "")).lower()
            sec("Windows boot configuration", f"{src}: {f.name}")
            if mgr:
                order = mgr.get("displayorder") or []
                print(f"  Boot manager: timeout {mgr.get('timeout', '?')} s · default {byg.get(default, {}).get('el', {}).get('description', default) or '?'}"
                      + (f" · {len(order)} entr{'y' if len(order) == 1 else 'ies'} in the menu" if order else ""))
            loaders = [e for e in entries if e["type"] == "Windows Boot Loader"]
            loaders.sort(key=lambda e: (e["guid"] != default, str(e["el"].get("description", ""))))
            hv = byg.get("{7ff607e0-4395-11db-b0de-0800200c9a66}", {}).get("el", {})
            for e in loaders:
                el = e["el"]
                tag = " (default)" if e["guid"] == default else ""
                print(f"  {C['bold']}{el.get('description', '?')}{C['end']}{tag}  {C['dim']}{e['guid']}{C['end']}")
                print(f"    {el.get('path', '?')} · systemroot {el.get('systemroot', '?')}"
                      + (" · WinPE" if el.get("winpe") else ""))
                flags = {k: el[k] for k in ("hypervisorlaunchtype", "nx", "bootstatuspolicy", "recoveryenabled", "bootmenupolicy",
                                             "testsigning", "nointegritychecks", "safeboot", "debug", "bootdebug") if k in el}
                if flags:
                    print("    " + " · ".join(f"{k} {v}" for k, v in flags.items()))
                for k, why in BCD_WARN.items():
                    if el.get(k) not in (None, False):
                        print(f"    {C['yel']}! {k}: {why}{C['end']}")
            if hv:
                print(f"  Hypervisor settings: " + " · ".join(f"{k} {v}" for k, v in hv.items() if not k.startswith("0x")) or "default")
            others = [e for e in entries if e["type"] not in ("Windows Boot Loader",) and e["guid"] not in BCD_WELL_KNOWN]
            if others:
                print(f"  {C['dim']}Other entries: " + ", ".join(f"{e['type']} {e['el'].get('description', '')}".strip() for e in others[:10]) + C["end"])
    finally:
        for mp in mounts:
            run(["umount", mp])
            try:
                os.rmdir(mp)
            except OSError:
                pass

# ── Read-only commands ─────────────────────────────────────────────────────

def cmd_list(_args):
    found = False
    for dev, mp in windows_installs():
        found = True
        i = winlib.info(mp)
        print(f"  {dev:22} {i['name']}" + (f"  ({i.get('computer_name')})" if i.get("computer_name") else ""))
    for dev in bitlocker_volumes():
        found = True
        mapped = Path(f"/dev/mapper/bitlocker-{os.path.basename(dev)}")
        state = f"unlocked → {mapped}" if mapped.exists() else "locked — sysmedic-win bitlocker " + dev
        print(f"  {dev:22} {C['yel']}BitLocker{C['end']} ({state})")
    if not found:
        print("  No Windows installations or BitLocker volumes found.")


def cmd_info(args):
    for dev, mp in windows_installs(args[0] if args else None):
        i = header(dev, mp)
        rows = [("Edition", i.get("edition")), ("Last clean shutdown", i.get("last_shutdown") or "unknown")]
        fs = "ON (Windows hibernates instead of shutting down)" if i.get("fast_startup") else "off"
        rows.append(("Fast Startup", fs))
        if i.get("hibernated"):
            rows.append(("Hibernation", f"{C['yel']}HIBERNATED NOW: don't write to this volume (sysmedic-win fix-hibernation){C['end']}"))
        pend = []
        if i.get("pending_xml"):
            pend.append("half-installed update (pending.xml)")
        if i.get("reboot_pending_cbs"):
            pend.append("servicing reboot pending")
        if i.get("pending_renames"):
            pend.append(f"{i['pending_renames']} file replacement(s) waiting for reboot")
        rows.append(("Pending at next boot", ", ".join(pend) if pend else "nothing"))
        rows.append(("Windows Recovery (WinRE)", {"configured": "available (Shift+Restart, or interrupt boot 3 times)",
                                                 "disabled": f"{C['yel']}disabled — use Windows install media for repairs{C['end']}",
                                                 "unknown": "unknown"}[i.get("winre", "unknown")]))
        for p in i.get("profiles", []):
            rows.append(("User profile", f"{p['name']}" + (f" (last used {p['last_used']})" if p.get("last_used") else "")))
        st = os.statvfs(mp)
        rows.append(("Free space", f"{st.f_bavail * st.f_frsize / 1e9:.1f} GB of {st.f_blocks * st.f_frsize / 1e9:.1f} GB"))
        for k, v in rows:
            print(f"  {k:26} {v}")


def cmd_crashes(args):
    for dev, mp in targets(args):           # a partition (BitLocker → its unlocked copy) or a mounted folder
        cs = winlib.crashes(mp)
        sec("Crash dumps", "Windows\\Minidump, MEMORY.DMP")
        if not cs:
            print("  none found")
        counts = {}
        for c in cs:
            counts[c["code"]] = counts.get(c["code"], 0) + 1
            print(f"  {c['time']}  {C['red']}{c['code'] or '?':12}{C['end']} {c['name']:36} {C['dim']}{c['hint']}{C['end']}")
        if cs:
            top, n = max(counts.items(), key=lambda kv: kv[1])
            hint = next(c["hint"] for c in cs if c["code"] == top)
            if n == len(cs) and n > 1:
                print(f"  {C['bold']}Pattern:{C['end']} all {n} crashes share one stop code ({top}): {hint}.")
            elif n > len(cs) / 2:
                print(f"  {C['bold']}Pattern:{C['end']} {n} of {len(cs)} crashes are {top}: {hint}.")
            elif len(counts) > 2:
                print(f"  {C['bold']}Pattern:{C['end']} {len(counts)} different stop codes; varied codes often mean hardware (RAM, heat, power).")
        wr = winlib.wer_reports(mp)
        sec("Crash reports kept by Windows Error Reporting", "blue screens and live kernel events, newest first")
        if not wr:
            print("  none found (WER ReportArchive/ReportQueue, LiveKernelReports)")
        for r in wr[:20]:
            code = f"{C['red']}{r['code']}{C['end']} {r['name']}" if r["code"] else ""
            print(f"  {r['time']}  {r['type']:22} {code}  {C['dim']}{r['detail'] or r['folder']}{C['end']}")
        if any(r["type"] == "LiveKernelEvent" for r in wr):
            print(f"  {C['dim']}LiveKernelEvent = a driver or device hung and was reset without a blue screen "
                  f"(0x141/0x117/0x193 graphics, 0x144 USB 3); repeated ones point at that driver or device.{C['end']}")
        hints = {r["code"]: winlib.BUGCHECKS.get(int(r["code"], 16), ("", ""))[1] for r in wr if r["code"].startswith("0x")}
        for code, hint in hints.items():
            if hint and code not in counts:
                print(f"  {C['dim']}{code}: {hint}{C['end']}")
        evs = winlib.events(mp) or []
        bsod = [e for e in evs if e["category"] == "crash"]
        if bsod:
            print(f"\n  Event log: {sum(e['count'] for e in bsod)} crash event(s), latest {bsod[0]['last']}")


def cmd_events(args):
    for dev, mp in windows_installs(args[0] if args and not args[0].startswith("-") else None):
        header(dev, mp)
        evs = winlib.events(mp)
        if evs is None:
            print("  System event log not found or unreadable.")
            continue
        if not evs:
            print("  No notable events.")
        colour = {"disk": "red", "hardware": "red", "crash": "red", "power": "yel", "persistence": "yel",
                  "update": "yel", "service": "cyan", "error": "dim"}
        for e in evs[:25]:
            col = C[colour.get(e["category"], "dim")]
            span = e["last"] if e["first"] == e["last"] else f"{e['first'][:10]} → {e['last']}"
            print(f"  {col}{e['count']:5}× {e['meaning']}{C['end']}  {C['dim']}[{e['provider']} {e['id']}] {span}{C['end']}")
            if e["category"] in ("persistence", "crash", "disk", "update"):
                for x in e["examples"][:2]:
                    detail = ", ".join(f"{k}={v}" for k, v in x.items() if k != "time")[:150]
                    print(f"         {C['dim']}{x['time']}  {detail}{C['end']}")
        if len(evs) > 25:
            print(f"  … {len(evs) - 25} more groups")


def cmd_autoruns(args):
    for dev, mp in windows_installs(args[0] if args else None):
        header(dev, mp)
        items = winlib.autoruns(mp)
        sus = [i for i in items if i["suspicious"]]
        for i in sorted(items, key=lambda x: (not x["suspicious"], x["where"])):
            mark = f"{C['red']}SUSPICIOUS{C['end']} " if i["suspicious"] else "           "
            missing = f" {C['dim']}(file missing){C['end']}" if i["exists"] is False else ""
            print(f"  {mark}{i['where']:24} {i['name'][:34]:34} {i['command'][:90]}{missing}")
            if i["suspicious"]:
                print(f"             {C['yel']}↳ {i['suspicious']}{C['end']}")
        print(f"\n  {len(items)} autostart entries, {len(sus)} suspicious." +
              (" Next: sysmedic-win malware " + dev if sus else ""))


def cmd_malware(args):
    full = "--full" in args
    args = [a for a in args if a != "--full"]
    if not CLAMDB.is_dir() or not any(CLAMDB.glob("*.c[vl]d")):
        sys.exit("No ClamAV signatures on the stick (/mnt/persist/clamav). Connect to the internet and run: freshclam --datadir=/mnt/persist/clamav")
    if run(["curl", "-s", "-o", "/dev/null", "--max-time", "5", "https://database.clamav.net"]).returncode == 0:
        print("  Updating virus signatures…")
        run(["freshclam", f"--datadir={CLAMDB}", "--quiet", "--foreground"], timeout=600)
    age = (datetime.datetime.now() - datetime.datetime.fromtimestamp(max(f.stat().st_mtime for f in CLAMDB.glob("*.c[vl]d")))).days
    print(f"  Signatures: {age} day(s) old")
    for dev, mp in windows_installs(args[0] if args else None):
        header(dev, mp)
        if full:
            targets = [mp]
        else:
            targets = {str(p) for i in winlib.autoruns(mp) if (p := winlib.win_to_local(mp, i["command"]))}
            for rel in ["ProgramData", "Windows/Temp"]:
                if (p := winlib.ci_path(mp, rel)):
                    targets.add(str(p))
            users = winlib.ci_path(mp, "Users")
            for u in (users.iterdir() if users and users.is_dir() else []):
                for rel in ["AppData/Roaming", "AppData/Local/Temp", "Downloads", "Desktop"]:
                    if (p := winlib.ci_path(u, rel)):
                        targets.add(str(p))
            targets = sorted(targets)
        print(f"  Scanning {'the whole volume' if full else f'{len(targets)} autostart files and user/program-data folders'} (read-only)…")
        p = run(["clamscan", f"--database={CLAMDB}", "-r", "--infected", "--no-summary", "--max-filesize=200M", *targets], timeout=7200)
        hits = list(dict.fromkeys(l for l in p.stdout.splitlines() if l.endswith(" FOUND")))
        for h in hits:
            path, sig = h[:-6].rsplit(": ", 1)
            print(f"  {C['red']}INFECTED{C['end']} {sig:40} C:\\{os.path.relpath(path, mp)}")
        print(f"  {len(hits)} infected file(s)." + ("" if not hits else
              "  Don't delete in place: copy to /mnt/persist/backups for analysis, then quarantine from Windows or reinstall."))
        audit(f"malware scan of {dev}: {len(hits)} detection(s)")


# ── Engineer-only commands ─────────────────────────────────────────────────

def bitlocker_open(dev, key, rw=False, via="console"):
    """Unlock one BitLocker volume with a recovery key or password. Returns (ok, message, mapped device or None).
    Shared by the console and the web unlock; the key goes to cryptsetup on stdin and is never stored or logged."""
    name = f"bitlocker-{os.path.basename(dev)}"
    if Path(f"/dev/mapper/{name}").exists():
        return True, f"Already unlocked: /dev/mapper/{name}", f"/dev/mapper/{name}"
    if re.fullmatch(r"[\d\s-]{48,60}", key):
        digits = re.sub(r"\D", "", key)
        if len(digits) == 48:
            key = "-".join(digits[i:i + 6] for i in range(0, 48, 6))
    cmd = ["cryptsetup", "open", "--type", "bitlk", "--key-file=-", dev, name] + ([] if rw else ["--readonly"])
    p = subprocess.run(cmd, input=key, capture_output=True, text=True)
    key = None
    if p.returncode != 0:
        audit(f"BitLocker unlock of {dev} via {via} FAILED (wrong key?)")
        return False, "Unlock failed — check the key (Microsoft account: aka.ms/myrecoverykey).", None
    audit(f"BitLocker volume {dev} unlocked {'read-write' if rw else 'read-only'} via {via} → /dev/mapper/{name} (key not recorded)")
    return True, f"Unlocked {'read-write' if rw else 'read-only'} as /dev/mapper/{name}", f"/dev/mapper/{name}"


def mount_unlocked(name):
    """Mount a freshly unlocked BitLocker volume read-only. Returns (mountpoint or None, error text)."""
    if run(["blkid", "-o", "value", "-s", "TYPE", f"/dev/mapper/{name}"]).stdout.strip() != "ntfs":
        return None, "not NTFS"
    mp = RUN / "win" / name
    mp.mkdir(parents=True, exist_ok=True)
    if run(["findmnt", "-rno", "TARGET", str(mp)]).stdout.strip():
        return mp, ""
    m = run(["ntfs-3g", "-o", "ro", f"/dev/mapper/{name}", str(mp)])
    if m.returncode == 0:
        return mp, ""
    return None, next((l for l in (m.stderr + m.stdout).splitlines() if "Failed" in l or "error" in l.lower()), "unknown error")


def cmd_bitlocker(args):
    human_only("bitlocker unlock")
    if not args:
        sys.exit("Usage: sysmedic-win bitlocker /dev/PARTITION")
    dev = args[0]
    if run(["blkid", "-o", "value", "-s", "TYPE", dev]).stdout.strip() != "BitLocker":
        sys.exit(f"{dev} is not a BitLocker volume.")
    name = f"bitlocker-{os.path.basename(dev)}"
    if Path(f"/dev/mapper/{name}").exists():
        print(f"  Already unlocked: /dev/mapper/{name}")
        return
    rw = "--rw" in args
    if rw and is_locked(dev):
        sys.exit(f"For read-write access unlock the partition first: sysmedic-unlock {dev}")
    print("  Enter the 48-digit BitLocker recovery key (or the user's BitLocker password).")
    print(f"  {C['dim']}It is used once and never stored or logged.{C['end']}")
    import getpass
    ok, msg, _mapped = bitlocker_open(dev, getpass.getpass("  Key: ").strip(), rw)
    if not ok:
        sys.exit(f"  {msg}")
    print(f"  {C['grn']}{msg}{C['end']}")
    if run(["blkid", "-o", "value", "-s", "TYPE", f"/dev/mapper/{name}"]).stdout.strip() == "ntfs":
        mp, why = mount_unlocked(name) if not rw else (None, "")
        if mp:
            print(f"  Files are readable at {mp}")
        elif not rw:
            print(f"  {C['yel']}Decrypted, but the NTFS filesystem inside won't mount:{C['end']} {why}")
            print(f"  The data may be damaged. Image it first: ddrescue /dev/mapper/{name} <external>/bitlocker.img <external>/bitlocker.map")
        print(f"  Next: sysmedic-win info /dev/mapper/{name}   ·   copy data to /mnt/persist/backups or an external drive")
    print(f"  Lock it again with: cryptsetup close {name}")


def cmd_bitlocker_web(args):
    # From a console, or started by the phone dashboard (--background, SYSMEDIC_VIA_PHONE=1); never by the AI
    phone = "--background" in args and os.environ.get("SYSMEDIC_VIA_PHONE") == "1"
    if phone:
        if called_by_ai():
            audit("REFUSED bitlocker web unlock: requested by the AI assistant")
            sys.exit("REFUSED: the AI can't start the BitLocker unlock.")
    else:
        human_only("bitlocker web unlock")
    import blweb
    try:
        st = json.loads(Path(blweb.STATE).read_text())
        if st.get("running") and Path(f"/proc/{st['pid']}").exists():
            print(f"  Already running (port {st['port']})."); return
    except (OSError, ValueError, KeyError):
        pass

    def volumes():
        return [(d, run(["lsblk", "-dno", "SIZE", d]).stdout.strip(), run(["lsblk", "-dno", "PARTLABEL", d]).stdout.strip())
                for d in bitlocker_volumes()]

    machine = run(["cat", "/sys/class/dmi/id/sys_vendor", "/sys/class/dmi/id/product_name"]).stdout.split("\n")
    machine = " ".join(x.strip() for x in machine if x.strip())
    sys.exit(blweb.serve(volumes, lambda dev, key: bitlocker_open(dev, key, via="phone" if phone else "web"), mount_unlocked, audit,
                         machine, C, via="phone dashboard" if phone else "console"))


def confirm(prompt):
    return input(f"  {prompt} Type yes to continue: ").strip().lower() == "yes"


def backup_dir():
    d = (RUN / "latest").resolve() / "backups" if (RUN / "latest").exists() else RUN / "backups"
    d.mkdir(parents=True, exist_ok=True)
    return d


def cmd_fix_update(args):
    human_only("fix-update")
    part = args[0] if args else sys.exit("Usage: sysmedic-win fix-update /dev/PARTITION")
    if is_locked(part):
        sys.exit(f"  {part} is write-protected. Unlock it first on Alt+F2: sysmedic-unlock {part}")
    print("  This makes Windows skip the half-installed update on next boot (it can be retried later).")
    print(f"  {C['dim']}If WinRE works, the official route is: dism /image:C:\\ /cleanup-image /revertpendingactions{C['end']}")
    if not confirm("Rename Windows\\WinSxS\\pending.xml?"):
        return
    try:
        with Mounted(part, rw=True) as mp:
            px = winlib.ci_path(mp, "Windows/WinSxS/pending.xml")
            if not px:
                print("  No pending.xml — nothing to roll back.")
                return
            shutil.copy2(px, backup_dir() / "pending.xml")
            stamp = datetime.datetime.now().strftime("%Y%m%d%H%M")
            px.rename(px.with_name(f"pending.xml.sysmedic-{stamp}"))
            audit(f"fix-update on {part}: renamed WinSxS\\pending.xml (copy in backups/)")
            print(f"  {C['grn']}Done.{C['end']} Original copied to backups/pending.xml. Boot Windows, then run Windows Update again.")
    except RuntimeError as e:
        sys.exit(f"  Not changed: {e}")


def cmd_fix_hibernation(args):
    human_only("fix-hibernation")
    part = args[0] if args else sys.exit("Usage: sysmedic-win fix-hibernation /dev/PARTITION")
    if is_locked(part):
        sys.exit(f"  {part} is write-protected. Unlock it first on Alt+F2: sysmedic-unlock {part}")
    print(f"  {C['yel']}Windows was hibernated (or Fast Startup is holding the disk).{C['end']}")
    print("  Discarding it loses anything the user had open and unsaved. Their files on disk are not affected.")
    print("  Better, if Windows still boots: start it, then Shift+Shut down.")
    if not confirm("Discard the hibernation state?"):
        return
    if is_locked(part):
        sys.exit(f"  {part} is write-protected. Unlock it first on Alt+F2: sysmedic-unlock {part}")
    try:
        with Mounted(part, rw=True, extra="remove_hiberfile"):
            pass
    except RuntimeError as e:
        sys.exit(f"  Not changed: {e}")
    audit(f"fix-hibernation on {part}: hiberfil.sys discarded")
    print(f"  {C['grn']}Done.{C['end']} Also turn off Fast Startup in Windows (Power Options) to stop it recurring.")


def cmd_reset_password(args):
    human_only("reset-password")
    part = args[0] if args else sys.exit("Usage: sysmedic-win reset-password /dev/PARTITION")
    if is_locked(part):
        sys.exit(f"  {part} is write-protected. Unlock it first on Alt+F2: sysmedic-unlock {part}")
    print("  Works for LOCAL accounts only. Microsoft-account sign-ins (email address) must be reset at")
    print("  account.live.com/password/reset. Make sure the machine's owner has authorised this.")
    if not confirm("Open the password tool?"):
        return
    try:
        mounted = Mounted(part, rw=True)
        mp = mounted.__enter__()
    except RuntimeError as e:
        sys.exit(f"  Not changed: {e}")
    try:
        sam = winlib.ci_path(mp, "Windows/System32/config/SAM")
        if not sam:
            sys.exit("  SAM hive not found.")
        shutil.copy2(sam, backup_dir() / "SAM")
        audit(f"reset-password on {part}: chntpw opened (SAM backed up)")
        subprocess.run(["chntpw", "-i", str(sam)])
        audit(f"reset-password on {part}: chntpw closed")
    finally:
        mounted.__exit__()


# ── Deep troubleshooting: event logs, registry, servicing ──────────────────

SEV = {"critical": "red", "warning": "yel", "info": "dim", "ok": "grn"}


def opt(args, name, default):
    if name in args:
        i = args.index(name)
        try:
            return int(args[i + 1])
        except (IndexError, ValueError):
            sys.exit(f"{name} needs a number")
    return default


def targets(args):
    """Yield (label, path): files/folders given on the command line, else each Windows installation."""
    plain = [a for i, a in enumerate(args) if not a.startswith("--") and not (i and args[i - 1] == "--days")]
    paths = [Path(a) for a in plain if Path(a).exists() and not Path(a).is_block_device()]
    if paths:
        for p in paths:
            yield str(p), p
        return
    for dev, mp in windows_installs(plain[0] if plain else None):
        header(dev, mp)
        yield dev, Path(mp)


def print_evtx(r, days):
    print(f"  Read {r['logs']} of {r['files']} event logs" + (f" (last {days} days)" if days else "")
          + (f"; {r['empty']} were empty" if r.get("empty") else "")
          + (f"; {r['skipped']} skipped (--curated: only the problem-explaining logs)" if r.get("skipped") else "") + ".")
    for x in r.get("failed", [])[:10]:
        print(f"  {C['yel']}Couldn't read {x}{C['end']}")
    for e in r["errors"]:
        print(f"  {C['yel']}{e}{C['end']}")
    main_f = [f for f in r["findings"] if f["category"] != "error"]
    other = [f for f in r["findings"] if f["category"] == "error"]
    if not r["findings"]:
        print(f"  {C['grn']}No notable events.{C['end']}")
    for f in main_f[:40]:
        span = f["last"] if f["first"] == f["last"] else f"{f['first'][:10]} → {f['last']}"
        print(f"  {C[SEV[f['severity']]]}{f['count']:5}× {f['meaning']}{C['end']}  {C['dim']}[{f['log']}: {f['provider']} {f['id']}] {span}{C['end']}")
        if f["severity"] != "info" or f["category"] in ("persistence", "change"):
            for x in f["examples"][:2]:
                detail = ", ".join(f"{k}={v}" for k, v in x.items() if k != "time")[:160]
                if detail:
                    print(f"         {C['dim']}{x['time']}  {detail}{C['end']}")
    if len(main_f) > 40:
        print(f"  … {len(main_f) - 40} more groups")
    if r["boot"]:
        times = ", ".join(f"{t[:10]} {s:.0f}s" for t, s in r["boot"][-6:])
        sec("Boot times", "Windows' own measurement")
        print(f"  {times}")
    if other:
        sec("Other errors across all logs", f"{len(other)} kinds")
        for f in other[:15]:
            print(f"  {C['dim']}{f['count']:5}× {f['log'][:60]}: {f['provider']} {f['id']}  (last {f['last']}){C['end']}")


def cmd_evtx(args):
    days = opt(args, "--days", 30)
    for label, path in targets(args):
        prog = (lambda n: print(f"\r\033[K  {C['dim']}reading {n[:90]}{C['end']}", end="", flush=True)) if COLOR else None
        r = winevidence.scan_evtx(path, days=days, sweep="--curated" not in args, progress=prog)
        if COLOR:
            print("\r\033[K", end="")
        print_evtx(r, days)


def print_registry(r, days):
    if not r["findings"]:
        print(f"  {C['grn']}No problems found in the registry.{C['end']}")
    for f in r["findings"]:
        print(f"  {C[SEV[f['severity']]]}{f['severity'].upper():8}{C['end']} {f['title']}")
        if f["detail"]:
            print(f"           {C['dim']}{f['detail'][:200]}{C['end']}")
        if f["fix"]:
            print(f"           {C['cyan']}↳ {f['fix'][:200]}{C['end']}")
    if r["recent"]:
        sec(f"Changed in the last {days} days", "line these up with when the problem started")
        for x in r["recent"][:25]:
            print(f"  {x['when_days']:3}d ago  {x['what'][:70]}  {C['dim']}{x['detail'][:70]}{C['end']}")


def cmd_registry(args):
    days = opt(args, "--days", 30)
    for label, path in targets(args):
        print_registry(winevidence.scan_registry(path, days=days), days)


def print_servicing(s):
    print(f"  Read {len(s['read'])} log(s)." + (" " + "; ".join(s["notes"]) if s["notes"] else ""))
    if not s["read"] and not s["wu"]["failed"] and not s["panther"]:
        print("  No servicing logs found (Windows/Logs/CBS, Windows/Logs/DISM).")
    sec("Verdict")
    for sev, title, fix in winevidence.servicing_verdict(s):
        print(f"  {C[SEV.get(sev, 'dim')]}{title}{C['end']}")
        if fix:
            print(f"    {C['cyan']}↳ {fix}{C['end']}")
    if s["wu"]["failed"]:
        sec("Windows Update failures", "ReportingEvents.log")
        for t, g in sorted(s["wu"]["failed"].items(), key=lambda kv: kv[1]["last"], reverse=True)[:12]:
            print(f"  {g['count']:3}× {t[:100]}  {C['dim']}{', '.join(g['codes'])} last {g['last']}{C['end']}")
    if s["wu"]["installed"]:
        w, t = s["wu"]["installed"][-1]
        print(f"  Last successful update: {w}  {C['dim']}{t[:100]}{C['end']}")
    if s["errors"]:
        sec("Servicing errors", "CBS/DISM, grouped")
        for g in s["errors"][:15]:
            meaning = f"  {C['cyan']}{g['meaning']}{C['end']}" if g["meaning"] else ""
            pk = f"  {C['dim']}{', '.join(g['packages'])}{C['end']}" if g["packages"] else ""
            print(f"  {g['count']:5}× {C['yel']}{g['code'] or '—'}{C['end']} {g['tool']}: {g['message'][:110]}{pk}{meaning}")
    if s["corruption_count"]:
        print(f"\n  {C['red']}Corruption evidence: {s['corruption_count']} line(s){C['end']} (latest):")
        for w, m in s["corruption"][-6:]:
            print(f"  {C['dim']}{w}  {m[:150]}{C['end']}")
    sfc = s["sfc"]
    if sfc:
        parts = [f"last run {sfc['last_run']}" if sfc.get("last_run") else "",
                 f"{sfc['repaired']} repaired" if sfc.get("repaired") else "",
                 f"{C['red']}{sfc['unrepaired']} couldn't be repaired{C['end']}" if sfc.get("unrepaired") else "",
                 f"DISM found {sfc['dism_detected']}, repaired {sfc.get('dism_repaired', 0)}" if "dism_detected" in sfc else ""]
        print(f"\n  SFC/DISM: {', '.join(p for p in parts if p)}")
    for p in s["panther"]:
        print(f"\n  {C['yel']}Upgrade log {p['file']}{C['end']}: {p['errors']} error line(s), codes {', '.join(p['codes']) or 'none known'}")
        print(f"  {C['dim']}last: {p['last']}{C['end']}")
    bad = [x for x in s["sessions"] if x[2] and x[2] not in ("0x00000000", "0x00000bc2")]
    if bad:
        print(f"\n  Failed servicing sessions: " + ", ".join(f"{w[:10]} {pk or '?'} {hr}" for w, pk, hr in bad[-6:]))


def cmd_cbs(args):
    days = opt(args, "--days", 90)
    for label, path in targets(args):
        print_servicing(winevidence.scan_servicing(path, days=days))


def print_etl(r, days):
    print(f"  Decoded {r['decoded_files']} of {r['files']} trace files ({r['events']} events)" + (f", last {days} days" if days else "") + ".")
    for c in r["coverage"]:
        if c.get("note"):
            print(f"  {C['dim']}{c['file']}: {c['note']}{C['end']}")
    if not r["findings"]:
        print(f"  {C['grn']}No failure codes in the traces.{C['end']}")
    for g in r["findings"][:25]:
        span = g["first"][:16].replace("T", " ") + ("" if g["first"][:16] == g["last"][:16] else f" → {g['last'][11:16]}")
        print(f"  {g['count']:5}× {C['yel']}{g['code']}{C['end']} {g['source']}  {C['dim']}{span}{C['end']}")
        if g["meaning"]:
            print(f"         {C['cyan']}{g['meaning']}{C['end']}")
        else:
            print(f"         {C['dim']}{g['example'][:120]}{C['end']}")


def cmd_etl(args):
    days = opt(args, "--days", 7)
    for label, path in targets(args):
        prog = (lambda n: print(f"\r\033[K  {C['dim']}decoding {n[:90]}{C['end']}", end="", flush=True)) if COLOR else None
        r = winevidence.scan_etl(path, days=days, progress=prog)
        if COLOR:
            print("\r\033[K", end="")
        print_etl(r, days)


def cmd_checkup(args):
    """Everything, on screen and as a markdown report in the session folder."""
    import contextlib
    import io
    days = opt(args, "--days", 30)
    plain = [a for i, a in enumerate(args) if not a.startswith("--") and not (i and args[i - 1] == "--days")]
    for dev, mp in windows_installs(plain[0] if plain else None):
        buf = io.StringIO()
        sections = [("Overview", lambda: cmd_info([dev])), ("Crashes", lambda: cmd_crashes([dev])),
                    ("Event logs", lambda: print_evtx(winevidence.scan_evtx(mp, days=days), days)),
                    ("Registry evidence", lambda: print_registry(winevidence.scan_registry(mp, days=days), days)),
                    ("Servicing (CBS, DISM, Windows Update)", lambda: print_servicing(winevidence.scan_servicing(mp, days=max(days, 90)))),
                    ("Traces (ETL: Windows Update and other components)", lambda: print_etl(winevidence.scan_etl(mp, days=min(days, 14)), min(days, 14))),
                    ("Autostart", lambda: cmd_autoruns([dev]))]
        for title, fn in sections:
            sec(title)
            out = io.StringIO()
            with contextlib.redirect_stdout(out):
                saved = dict(C)
                C.update({k: "" for k in C})          # plain text for the report
                try:
                    fn()
                finally:
                    C.update(saved)
            text = out.getvalue()
            print(text.rstrip())
            buf.write(f"\n## {title}\n\n```\n{text.strip(chr(10))}\n```\n")
        latest = RUN / "latest"
        d = latest.resolve() if latest.exists() else Path("/root")
        f = d / f"windows-checkup-{os.path.basename(dev)}.md"
        f.write_text(f"# Windows check-up: {dev}\n\n{datetime.datetime.now():%Y-%m-%d %H:%M}, read-only, last {days} days "
                     f"(servicing: {max(days, 90)}). Generated by sysmedic-win checkup.\n" + buf.getvalue())
        print(f"\n  {C['grn']}Report saved: {f}{C['end']}  (included in the job report and review bundle)")
        audit(f"windows checkup {dev} -> {f.name}")


COMMANDS = {"info": cmd_info, "crashes": cmd_crashes, "events": cmd_events, "autoruns": cmd_autoruns,
            "malware": cmd_malware, "evtx": cmd_evtx, "registry": cmd_registry, "reg": cmd_reg, "bcd": cmd_bcd, "cbs": cmd_cbs, "etl": cmd_etl,
            "checkup": cmd_checkup, "bitlocker": cmd_bitlocker, "bitlocker-web": cmd_bitlocker_web, "fix-update": cmd_fix_update,
            "fix-hibernation": cmd_fix_hibernation, "reset-password": cmd_reset_password}


def main():
    if os.geteuid() != 0:
        sys.exit("sysmedic-win must run as root")
    args = sys.argv[1:]
    if not args:
        return cmd_list([])
    if args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if args[0] not in COMMANDS:
        sys.exit(f"Unknown command '{args[0]}'. Try: sysmedic-win help")
    try:
        COMMANDS[args[0]](args[1:])
    except KeyboardInterrupt:
        sys.exit("\n  Cancelled.")
    except OSError as e:
        sys.exit(f"  Error: {e}")


if __name__ == "__main__":
    main()
