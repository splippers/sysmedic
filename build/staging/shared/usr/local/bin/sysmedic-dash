</main><div id=toast></div>
<script>
const T=new URLSearchParams(location.search).get('t')||'';const H={'Content-Type':'application/json','X-Token':T};
const $=id=>document.getElementById(id);let jobLoaded=false;
function el(tag,cls,text){const e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=text;return e}
function toast(m){const t=$('toast');t.textContent=m;t.style.display='block';setTimeout(()=>t.style.display='none',2500)}
function size(n){return n>1e9?(n/1e9).toFixed(1)+' GB':n>1e6?(n/1e6).toFixed(1)+' MB':n>1e3?Math.round(n/1e3)+' KB':n+' B'}
async function refresh(){
