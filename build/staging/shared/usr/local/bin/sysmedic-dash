.f{border-left:3px solid var(--line);padding:6px 0 6px 10px;margin:6px 0}.f.critical{border-color:var(--crit)}.f.warning{border-color:var(--warn)}.f.info{border-color:var(--info)}.f.ok{border-color:var(--ok)}
