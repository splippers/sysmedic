</script></html>"""


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "SysMedic"

    def log_message(self, *a):
        pass

    def authed(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        sent = self.headers.get("X-Token") or (q.get("t") or [""])[0]
        ok = secrets.compare_digest(sent, token())
        if ok and self.client_address[0] not in seen_clients:
            seen_clients.add(self.client_address[0])
            session.audit("phone", f"dashboard opened from {self.client_address[0]}")
        return ok

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else (body if isinstance(body, str) else json.dumps(body)).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith("text") or ctype.endswith("json") else ""))
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if not self.authed():
            return self.send(403, "Scan the QR code shown on the SysMedic console (Alt+F2, or run sysmedic-dash).", "text/plain")
        if path == "/":
            return self.send(200, PAGE, "text/html")
        if path == "/api/status":
            return self.send(200, status())
        if path == "/api/tests":
            return self.send(200, tests_state())
        if path == "/api/tests/log":
            run = (urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("run") or [""])[0]
            p = subprocess.run(["/usr/local/bin/sysmedic-tests", "log", run, "-n", "200"], capture_output=True, text=True, timeout=20)
            return self.send(200, p.stdout, "text/plain")
        if path in ("/report", "/report.txt"):
            f = session.session_dir() / ("report.html" if path == "/report" else "report.txt")
            if not f.exists():
                return self.send(404, "No report yet — generate it first.", "text/plain")
            return self.send(200, f.read_bytes(), "text/html" if path == "/report" else "text/plain")
        return self.send(404, "not found", "text/plain")

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        # Writes need the token in a header, which a page on another site cannot send (CSRF)
        if not self.headers.get("X-Token") or not self.authed():
            return self.send(403, "forbidden", "text/plain")
        try:
            body = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 20000)) or b"{}")
        except (ValueError, json.JSONDecodeError):
            return self.send(400, "bad request", "text/plain")
        if path == "/api/note":
            session.add_note(str(body.get("text", "")), "phone")
            return self.send(200, {"ok": True})
        if path == "/api/job":
            job = session.load_job()
            changed = [k for k in ("customer", "contact", "complaint", "engineer", "job_ref")
                       if k in body and job.get(k) != str(body[k])[:300]]
            for k in changed:
                job[k] = str(body[k]).strip()[:300]
            session.save_job(job)
            if changed:
                session.audit("phone", "JOB details updated: " + ", ".join(changed))
            return self.send(200, {"ok": True})
        if path == "/api/tests/start":
            args = ["/usr/local/bin/sysmedic-tests", "start", str(body.get("test", ""))]
            if body.get("disk"):
                args += ["--disk", str(body["disk"])]
            if body.get("minutes"):
                args += ["--minutes", str(body["minutes"])]
            p = subprocess.run(args, capture_output=True, text=True, timeout=30, env=dict(os.environ, SYSMEDIC_TESTS_VIA="phone"))
            return self.send(200 if p.returncode == 0 else 400, {"ok": p.returncode == 0, "message": (p.stdout + p.stderr).strip()}
                             if p.returncode == 0 else (p.stdout + p.stderr).strip(), "application/json" if p.returncode == 0 else "text/plain")
        if path == "/api/tests/stop":
            subprocess.run(["/usr/local/bin/sysmedic-tests", "stop", str(body.get("run", "all"))], capture_output=True, timeout=30)
            session.audit("phone", f"test stopped: {body.get('run', 'all')}")
            return self.send(200, {"ok": True})
        if path == "/api/bitlocker/start":
            # The key is never typed here (plain HTTP): this starts the HTTPS unlock page and sends the phone to it,
            # at the same address the phone used to reach this dashboard
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
            st = blweb_state()
            if not st.get("running"):
                session.audit("phone", "BitLocker unlock page requested from the dashboard")
                subprocess.Popen(["/usr/local/bin/sysmedic-win", "bitlocker-web", "--background"], start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=open("/run/sysmedic/blweb.log", "a"), stderr=subprocess.STDOUT,
                                 env=dict(os.environ, SYSMEDIC_VIA_PHONE="1", TERM="dumb"))
                for _ in range(40):
                    time.sleep(0.5)
                    st = blweb_state()
                    if st.get("running"):
                        break
            if not st.get("running"):
                why = Path("/run/sysmedic/blweb.log").read_text(errors="replace").strip().splitlines()[-1:] if Path("/run/sysmedic/blweb.log").exists() else []
                return self.send(500, "The unlock page didn't start" + (f": {why[0].strip()}" if why else ""), "text/plain")
            return self.send(200, {"ok": True, "url": f"https://{host}:{st['port']}{st['path']}",
                                   "fingerprint": st.get("fingerprint", "")[:23]})
        if path == "/api/report":
            with report_lock:
                p = subprocess.run(["/usr/local/bin/sysmedic-report"], capture_output=True, text=True, timeout=300)
            summary = next((l.strip() for l in p.stdout.splitlines() if l.strip().startswith("SysMedic found")), "Report built.")
            return self.send(200 if p.returncode == 0 else 500, {"ok": p.returncode == 0, "summary": summary})
        return self.send(404, "not found", "text/plain")


def tests_state():
    run = lambda *a: json.loads(subprocess.run(["/usr/local/bin/sysmedic-tests", *a, "--json"], capture_output=True, text=True,  # noqa: E731
                                               timeout=20).stdout or "[]")
    return {"tests": run("list"), "runs": run("status"), "disks": run("disks")}


def show_qr():
    t = token()
    ips = addresses()
    ui = UI()
    print(ui.section("Phone dashboard") + "\n  " + ui.c("dim", "status, job notes, tests, BitLocker unlock: scan the code with the phone camera"))
    if not ips:
        print(ui.item("warn", "No network yet", "put the phone on the same Wi-Fi (or USB tethering), then run: sysmedic-dash"))
        return
    for ip in ips:
        url = f"http://{ip}:{PORT}/?t={t}"
        print("  " + ui.c("accent", url))
        # Half blocks (▀ ▄ █, in SysMedic's console font): half the height of plain blocks, square modules,
        # so the engineer console's commands still fit above it
        subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", url])
    print("  " + UI().c("dim", "Anyone with this link can see this visit's findings."))


def serve():
    token()
    httpd = http.server.ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    httpd.daemon_threads = True
    httpd.serve_forever()


if __name__ == "__main__":
    if "--serve" in sys.argv:
        serve()
    else:
        show_qr()
