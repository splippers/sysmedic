@media (prefers-color-scheme:light){:root{--bg:#f3f5f9;--card:#fff;--ink:#1b2333;--muted:#5d6779;--line:#dde2ea;--crit:#c0392b;--warn:#b26a00;--info:#1f6fd1;--ok:#1a8a43;--accent:#2457c5}}
