 <button onclick=saveJob()>Save job details</button></div>
<div class=card><h2>Notes</h2><div id=notes></div><textarea id=note placeholder="e.g. Customer says it started after a power cut"></textarea>
 <button onclick=addNote()>Add note</button></div>
