#!/usr/bin/env python3
"""sysmedic-dash — phone dashboard for the current SysMedic visit.

  sysmedic-dash --serve    run the dashboard (started automatically at boot)
  sysmedic-dash            show its address and a QR code to scan with a phone

Shows live status, findings, write protection, the audit trail and backups;
takes job details and notes; builds and serves the job report. It cannot
repair, unlock or change anything on the computer being worked on.
Access needs the random token in the QR code; the phone must be on the same
network (same Wi-Fi, or USB tethering from the phone).
"""
import http.server
import json
import os
import secrets
import socket
import subprocess
import sys
import threading
import urllib.parse
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/sysmedic")
import session  # noqa: E402

PORT = 8080
TOKEN_FILE = Path("/run/sysmedic/dash.token")
seen_clients = set()
report_lock = threading.Lock()


def token():
    if TOKEN_FILE.exists():
        return TOKEN_FILE.read_text().strip()
    TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
    t = secrets.token_urlsafe(9)
    TOKEN_FILE.write_text(t)
    os.chmod(TOKEN_FILE, 0o600)
    return t


def addresses():
    out = subprocess.run(["ip", "-j", "-4", "addr"], capture_output=True, text=True).stdout
    try:
        return [a["local"] for i in json.loads(out) if i["ifname"] != "lo" for a in i.get("addr_info", [])]
    except (json.JSONDecodeError, KeyError):
        return []


def status():
    scans = session.scans()
    last = scans[-1] if scans else {}
    job = session.load_job()
    lines = session.audit_lines()
    ai = "cloud" if any("CONSENT cloud AI: yes" in l for l in lines) else "offline"
    s = last.get("system", {})
    d = session.session_dir()
    return {"machine": f"{s.get('manufacturer', '')} {s.get('model', '')}".strip(),
            "cpu": s.get("cpu", ""), "ram_gb": round(s.get("ram_bytes", 0) / 2**30),
            "firmware": s.get("firmware", ""), "secure_boot": s.get("secure_boot"),
            "oses": sorted({f["os"] for f in last.get("filesystems", []) if f.get("os")}),
            "scan_time": last.get("time", ""), "scans": len(scans),
            "findings": last.get("findings", []), "guard": session.guard_state(),
            "online": last.get("network", {}).get("online"), "ai": ai,
            "audit": lines[-40:], "backups": session.backups(), "job": job,
            "report": (d / "report.html").exists(), "session": d.name}


PAGE = r"""<!doctype html><html lang=en><meta charset=utf-8>
