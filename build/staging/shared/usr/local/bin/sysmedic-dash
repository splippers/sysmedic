textarea{min-height:70px}button,.btn{display:inline-block;font:inherit;font-weight:600;border:0;border-radius:8px;padding:9px 14px;background:var(--accent);color:#fff;margin:6px 6px 0 0;text-decoration:none;cursor:pointer}
button.secondary{background:var(--line);color:var(--ink)}.muted{color:var(--muted)}label{font-size:13px;color:var(--muted)}
details summary{cursor:pointer;color:var(--muted);font-size:13px}#toast{position:fixed;bottom:16px;left:16px;right:16px;text-align:center;background:var(--accent);color:#fff;padding:10px;border-radius:10px;display:none}
</style>
<header><h1 id=machine>SysMedic</h1><div class=sub id=sub>connecting…</div></header>
<main>
<div class=card><div class=stats>
 <div class=stat><b id=nc>–</b><span>critical</span></div><div class=stat><b id=nw>–</b><span>warnings</span></div>
 <div class=stat><b id=nb>–</b><span>backups</span></div><div class=stat><b id=ng>–</b><span>unlocked</span></div></div></div>
<div class=card><h2>Findings</h2><div id=findings></div></div>
<div class=card><h2>Disk write protection</h2><div id=guard></div><p class=muted style="font-size:13px;margin:8px 0 0">Unlocking is only possible on the rescue computer's console (Alt+F2).</p></div>
<div class=card><h2>Job</h2>
