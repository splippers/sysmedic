 const G=$('guard');G.replaceChildren();for(const [k,v] of Object.entries(s.guard))G.append(el('span','pill '+v,k.replace('/dev/','')+' '+v));
 const N=$('notes');N.replaceChildren();for(const n of (s.job.notes||[])){const d=el('div','f',n.text);d.prepend(el('small','',n.time.slice(11,16)+' · '+n.author));N.append(d)}
 if(!jobLoaded){for(const k of ['customer','contact','complaint','engineer','job_ref'])$(k).value=s.job[k]||'';jobLoaded=true}
 const B=$('backups');B.replaceChildren();for(const b of s.backups)B.append(el('div','',b.path+' · '+size(b.bytes)));if(!s.backups.length)B.textContent='none';
 $('audit').textContent=s.audit.join('\n');
 $('ropen').href='report?t='+encodeURIComponent(T);if(s.report){$('ropen').style.display='inline-block';$('rstate').textContent='Report ready.';}
}
async function post(path,body){const r=await fetch(path+'?t='+T,{method:'POST',headers:H,body:JSON.stringify(body)});if(!r.ok)throw new Error(await r.text());return r.json()}
async function saveJob(){const j={};for(const k of ['customer','contact','complaint','engineer','job_ref'])j[k]=$(k).value;await post('api/job',j);toast('Job details saved')}
async function addNote(){const t=$('note').value.trim();if(!t)return;await post('api/note',{text:t});$('note').value='';toast('Note added');refresh()}
async function makeReport(){$('rbtn').disabled=true;$('rstate').textContent='Re-scanning and building the report (about 30 s)…';
 try{const r=await post('api/report',{});$('rstate').textContent=r.summary;$('ropen').style.display='inline-block'}catch(e){$('rstate').textContent='Failed: '+e.message}
 $('rbtn').disabled=false;refresh()}
refresh();setInterval(refresh,5000);
</script></html>"""


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "SysMedic"

    def log_message(self, *a):
        pass

    def authed(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        sent = self.headers.get("X-Token") or (q.get("t") or [""])[0]
        ok = secrets.compare_digest(sent, token())
        if ok and self.client_address[0] not in seen_clients:
            seen_clients.add(self.client_address[0])
            session.audit("phone", f"dashboard opened from {self.client_address[0]}")
        return ok

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else (body if isinstance(body, str) else json.dumps(body)).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith("text") or ctype.endswith("json") else ""))
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if not self.authed():
            return self.send(403, "Scan the QR code shown on the SysMedic console (Alt+F2, or run sysmedic-dash).", "text/plain")
        if path == "/":
            return self.send(200, PAGE, "text/html")
        if path == "/api/status":
            return self.send(200, status())
        if path in ("/report", "/report.txt"):
            f = session.session_dir() / ("report.html" if path == "/report" else "report.txt")
            if not f.exists():
                return self.send(404, "No report yet — generate it first.", "text/plain")
            return self.send(200, f.read_bytes(), "text/html" if path == "/report" else "text/plain")
        return self.send(404, "not found", "text/plain")

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        # Writes need the token in a header, which a page on another site cannot send (CSRF)
        if not self.headers.get("X-Token") or not self.authed():
            return self.send(403, "forbidden", "text/plain")
        try:
            body = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 20000)) or b"{}")
        except (ValueError, json.JSONDecodeError):
            return self.send(400, "bad request", "text/plain")
        if path == "/api/note":
            session.add_note(str(body.get("text", "")), "phone")
            return self.send(200, {"ok": True})
        if path == "/api/job":
            job = session.load_job()
            changed = [k for k in ("customer", "contact", "complaint", "engineer", "job_ref")
                       if k in body and job.get(k) != str(body[k])[:300]]
            for k in changed:
                job[k] = str(body[k]).strip()[:300]
            session.save_job(job)
            if changed:
                session.audit("phone", "JOB details updated: " + ", ".join(changed))
            return self.send(200, {"ok": True})
        if path == "/api/report":
            with report_lock:
                p = subprocess.run(["/usr/local/bin/sysmedic-report"], capture_output=True, text=True, timeout=300)
            summary = next((l.strip() for l in p.stdout.splitlines() if l.strip().startswith("SysMedic found")), "Report built.")
            return self.send(200 if p.returncode == 0 else 500, {"ok": p.returncode == 0, "summary": summary})
        return self.send(404, "not found", "text/plain")


def show_qr():
    t = token()
    ips = addresses()
    print("\n  SysMedic phone dashboard (read-only + job notes)")
    if not ips:
        print("  No network yet. Put the phone on the same Wi-Fi, or plug it in and turn on USB tethering,")
        print("  then run: sysmedic-dash")
        return
    for ip in ips:
        url = f"http://{ip}:{PORT}/?t={t}"
        print(f"\n  {url}")
        # Plain ANSI colour blocks: the Linux console font has no half-block characters
        subprocess.run(["qrencode", "-t", "ANSI", "-m", "2", url])
    print("  Scan with the phone camera. Anyone with this link can see this visit's findings.")


def serve():
    token()
    httpd = http.server.ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    httpd.daemon_threads = True
    httpd.serve_forever()


if __name__ == "__main__":
    if "--serve" in sys.argv:
        serve()
    else:
        show_qr()
