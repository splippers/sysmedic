 $('machine').textContent=s.machine||'SysMedic';
 $('sub').textContent=[s.oses.join(', ')||'no OS found',s.ram_gb+' GB RAM',s.firmware+(s.secure_boot?' · Secure Boot':''),'AI: '+s.ai,'scan '+(s.scan_time||'').slice(11,16)].join(' · ');
 const c=s.findings.filter(f=>f.severity=='critical').length,w=s.findings.filter(f=>f.severity=='warning').length,u=Object.values(s.guard).filter(v=>v!='locked').length;
