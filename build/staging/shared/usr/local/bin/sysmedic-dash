#!/usr/bin/env python3
"""sysmedic-dash — phone dashboard for the current SysMedic visit.

  sysmedic-dash --serve    run the dashboard (started automatically at boot)
  sysmedic-dash            show its address and a QR code to scan with a phone

Shows live status, findings, write protection, the audit trail and backups;
takes job details and notes; builds and serves the job report; runs SysMedic's
hardware and software tests (sysmedic-tests: all read-only) and shows them live.
It cannot repair, unlock or change anything on the computer being worked on.
Access needs the random token in the QR code; the phone must be on the same
network (same Wi-Fi, or USB tethering from the phone).
"""
import http.server
import json
import os
import secrets
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/sysmedic")
import session  # noqa: E402

sys.path.insert(0, "/usr/local/lib/sysmedic")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib/sysmedic"))
from ui import UI  # noqa: E402

PORT = 8080
TOKEN_FILE = Path("/run/sysmedic/dash.token")
seen_clients = set()
report_lock = threading.Lock()


def token():
    if TOKEN_FILE.exists():
        return TOKEN_FILE.read_text().strip()
    TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
    t = secrets.token_urlsafe(9)
    TOKEN_FILE.write_text(t)
    os.chmod(TOKEN_FILE, 0o600)
    return t


def addresses():
    out = subprocess.run(["ip", "-j", "-4", "addr"], capture_output=True, text=True).stdout
    try:
        return [a["local"] for i in json.loads(out) if i["ifname"] != "lo" for a in i.get("addr_info", [])]
    except (json.JSONDecodeError, KeyError):
        return []


def status():
    scans = session.scans()
    last = scans[-1] if scans else {}
    job = session.load_job()
    lines = session.audit_lines()
    ai = "cloud" if any("CONSENT cloud AI: yes" in l for l in lines) else "offline"
    s = last.get("system", {})
    d = session.session_dir()
    return {"machine": f"{s.get('manufacturer', '')} {s.get('model', '')}".strip(),
            "cpu": s.get("cpu", ""), "ram_gb": round(s.get("ram_bytes", 0) / 2**30),
            "firmware": s.get("firmware", ""), "secure_boot": s.get("secure_boot"),
            "oses": sorted({f["os"] for f in last.get("filesystems", []) if f.get("os")}),
            "scan_time": last.get("time", ""), "scans": len(scans),
            "findings": last.get("findings", []), "guard": session.guard_state(),
            "online": last.get("network", {}).get("online"), "ai": ai,
            "audit": lines[-40:], "backups": session.backups(), "job": job,
            "report": (d / "report.html").exists(), "session": d.name,
            "bitlocker": bitlocker_state(), "battery": battery(), "hud": hud()}


def hud():
    """Live machine strip: CPU temperature, memory, load (like the console menu)."""
    import glob
    out = {}
    temps = []
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if open(f"{h}/name").read().strip() in ("coretemp", "k10temp", "zenpower"):
                temps += [int(open(f).read()) / 1000 for f in glob.glob(f"{h}/temp*_input")]
        except (OSError, ValueError):
            pass
    if temps:
        out["cpu_c"] = round(max(temps))
    try:
        mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo")}
        out["ram"] = f"{(mem['MemTotal'] - mem['MemAvailable']) / 2**20:.1f}/{mem['MemTotal'] / 2**20:.0f} GB"
        out["load"] = open("/proc/loadavg").read().split()[0]
    except (OSError, KeyError, ValueError):
        pass
    return out


def battery():
    """Charge, state and health of each battery, from the kernel (no tools needed)."""
    out = []
    for b in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        rd = lambda n: (b / n).read_text().strip() if (b / n).exists() else ""  # noqa: E731
        full = rd("energy_full") or rd("charge_full")
        design = rd("energy_full_design") or rd("charge_full_design")
        health = round(int(full) * 100 / int(design)) if full.isdigit() and design.isdigit() and int(design) else None
        out.append({"name": b.name, "percent": int(rd("capacity")) if rd("capacity").isdigit() else None,
                    "state": rd("status").lower(), "health": health, "cycles": int(rd("cycle_count")) if rd("cycle_count").isdigit() else None})
    return out


BLWEB = Path("/run/sysmedic/blweb.json")


def blweb_state():
    try:
        st = json.loads(BLWEB.read_text())
    except (OSError, ValueError):
        return {}
    if st.get("running") and not Path(f"/proc/{st.get('pid', 0)}").exists():
        st["running"] = False
    return st


def bitlocker_state():
    out = subprocess.run(["lsblk", "-J", "-p", "-o", "NAME,FSTYPE,SIZE,PARTLABEL"], capture_output=True, text=True).stdout
    vols = []
    def walk(ns):
        for n in ns:
            if n.get("fstype") == "BitLocker":
                vols.append({"dev": n["name"], "size": n.get("size") or "", "label": n.get("partlabel") or "",
                             "unlocked": Path(f"/dev/mapper/bitlocker-{os.path.basename(n['name'])}").exists()})
            walk(n.get("children") or [])
    try:
        walk(json.loads(out or "{}").get("blockdevices", []))
    except ValueError:
        pass
    st = blweb_state()
    return {"volumes": vols, "page": bool(st.get("running"))}


