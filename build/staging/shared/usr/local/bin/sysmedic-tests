sys.path.insert(0, "/usr/local/lib/sysmedic")
try:
    import session
except ImportError:      # outside SysMedic (e.g. generating OpenCode commands at deploy time)
    session = None

NETWORK = r"""
echo "== Interfaces"; ip -br addr
echo; echo "== Default route"; ip route show default || echo "  none"
gw=$(ip route show default | awk '{print $3; exit}')
[ -n "$gw" ] && { echo; echo "== Gateway $gw"; ping -c 3 -W 2 "$gw" | tail -2; }
echo; echo "== DNS"; resolvectl status 2>/dev/null | grep -E 'Current DNS|DNS Servers' | sort -u
getent hosts www.microsoft.com >/dev/null && echo "  name lookup: OK" || echo "  name lookup: FAILED"
echo; echo "== Internet"
curl -s -o /dev/null -w '  HTTPS to microsoft.com: %{http_code} in %{time_total}s\n' --max-time 8 https://www.microsoft.com || echo "  HTTPS: FAILED"
ping -c 3 -W 2 1.1.1.1 | tail -2
echo; echo "== Wi-Fi"; nmcli -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null
nmcli -f IN-USE,SSID,SIGNAL,RATE,SECURITY device wifi list 2>/dev/null | head -8
""".strip()

