#!/usr/bin/env python3
"""sysmedic-tests — every SysMedic hardware and software test, run in the background with live results.

One catalogue used by the console, the AI (OpenCode slash commands) and the phone dashboard.
Nothing here writes to the customer's disks: disk tests are read-only, Windows checks read a
read-only mount.

  sysmedic-tests menu                          pick a test, watch it live (menu 16)
  sysmedic-tests list [--json]                 the catalogue
  sysmedic-tests start TEST [--disk /dev/X] [--minutes N]
                                               start a test in the background; prints its run id
  sysmedic-tests status [RUN] [--json]         running and finished tests (latest first)
  sysmedic-tests watch RUN|TEST                show its output live until it finishes
  sysmedic-tests wait RUN|TEST [--timeout S]   wait for it to finish (default 540 s), then show the result
  sysmedic-tests log RUN|TEST [-n LINES]       the output so far
  sysmedic-tests stop RUN|TEST|all             stop a running test
  sysmedic-tests disks [--json]                disks you can test (not SysMedic's own)

Runs and their output are kept in the visit's session folder (tests/), so they're part of the
job report and the review bundle.
"""
import datetime
import difflib
