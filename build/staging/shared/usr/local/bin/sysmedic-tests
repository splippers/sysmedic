sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib/sysmedic"))
from ui import UI  # noqa: E402

C = {k: (v if sys.stdout.isatty() else "") for k, v in {"g": "\033[0;32m", "y": "\033[1;33m", "r": "\033[1;31m",
                                                        "b": "\033[1m", "d": "\033[2m", "e": "\033[0m"}.items()}


def session_dir():
    try:
        return session.session_dir()
    except Exception:  # noqa: BLE001
        return Path("/run/sysmedic")


def runs_dir():
    d = session_dir() / "tests"
    d.mkdir(parents=True, exist_ok=True)
    return d


def own_disk():
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/mnt/persist"], capture_output=True, text=True).stdout.strip() \
            or subprocess.run(["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True).stdout.strip()
        return subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True, text=True).stdout.split()[0]
    except (IndexError, OSError):
        return ""


def disks():
    out = json.loads(subprocess.run(["lsblk", "-J", "-d", "-o", "NAME,SIZE,MODEL,TRAN,TYPE"], capture_output=True, text=True).stdout or "{}")
    mine = own_disk()
    return [{"dev": "/dev/" + d["name"], "size": d["size"], "model": (d.get("model") or "").strip(), "tran": d.get("tran") or ""}
            for d in out.get("blockdevices", []) if d["type"] == "disk" and d["name"] != mine
            and not d["name"].startswith(("loop", "zram", "sr"))]


def runs():
    out = []
    for f in sorted(runs_dir().glob("*.json"), reverse=True):
        try:
            r = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        rc = Path(r["log"]).with_suffix(".rc")
        if rc.exists():
            r["state"] = "passed" if rc.read_text().strip() == "0" else "finished with errors"
            r["exit"] = rc.read_text().strip()
            r["ended"] = datetime.datetime.fromtimestamp(rc.stat().st_mtime).isoformat(timespec="seconds")
        elif r.get("stopped"):
            r["state"] = "stopped"
        else:
            alive = True
            try:
                os.kill(r["pid"], 0)
            except OSError:
                alive = False
            r["state"] = "running" if alive else "ended unexpectedly"
        out.append(r)
    return out


def find_run(key):
    rs = runs()
    if key in ("latest", None) and rs:
        return rs[0]
    key = real_test(key) or key
    return next((r for r in rs if r["run"] == key), None) or next((r for r in rs if r["test"] == key), None)


# Names people and AIs reach for; each maps to a real test.
ALIASES = {"mem": "ram", "memory": "ram", "memtest": "ram", "memtester": "ram", "ram-test": "ram",
           "memslot": "ram-modules", "memslots": "ram-modules", "dimm": "ram-modules", "dimms": "ram-modules", "sodimm": "ram-modules",
           "memory-modules": "ram-modules", "stressapptest": "ram-stress", "memory-stress": "ram-stress", "bandwidth": "ram-speed",
           "graphics": "gpu", "glmark2": "gpu", "vkmark": "gpu-bench", "screen": "gpu-display", "display": "gpu-display", "dead-pixels": "gpu-display",
           "burn-in": "gpu-stress", "bios": "firmware", "music": "audio-music", "beethoven": "audio-music", "speakers-music": "audio-music", "uefi": "firmware", "secureboot": "firmware", "secure-boot": "firmware", "tpm": "firmware", "fwupd": "firmware", "gpu-burn": "gpu-stress", "vaapi": "gpu-video", "video": "gpu-video", "displays": "gpu-info", "smart": "disk", "badblocks": "surface", "wifi": "network", "net": "network",
           "keyboard": "input", "touchpad": "input", "sound": "audio", "speakers": "audio", "virus": "malware", "clamav": "malware"}


def real_test(name):
    """The catalogue name for a test name or alias, or ''."""
    name = (name or "").strip().lower().lstrip("/")
    name = {v: k for k, v in SLASH.items()}.get(name, name)
    name = ALIASES.get(name, name)
    return name if name in TESTS else ""


def unknown_test(name):
    close = difflib.get_close_matches(name.lower(), list(TESTS) + list(ALIASES), n=3, cutoff=0.5)
    close = list(dict.fromkeys(real_test(c) for c in close))
    return (f"unknown test '{name}': no such SysMedic test." + (f" Did you mean: {', '.join(close)}?" if close else "")
            + f" Real tests: {', '.join(TESTS)}")


def start(test, disk="", minutes=None, via="console"):
    test = real_test(test) or test
    if test not in TESTS:
        raise ValueError(unknown_test(test))
    cat, title, _what, cmd, needs, _est, _person = TESTS[test]
    if any(r["test"] == test and r["state"] == "running" for r in runs()):
        raise ValueError(f"{title} is already running (sysmedic-tests status)")
    if needs == "disk":
        ok = {d["dev"] for d in disks()}
        if disk not in ok:
            raise ValueError(f"choose a disk to test: {', '.join(sorted(ok)) or 'none found'}")
    minutes = int(minutes or 5)
    if not 1 <= minutes <= 120:
        raise ValueError("minutes must be 1–120")
    cmd = cmd.replace("{disk}", shlex.quote(disk)).replace("{minutes}", str(minutes))
    stamp = datetime.datetime.now().strftime("%H%M%S")
    run_id = f"{test}-{stamp}"
    log = runs_dir() / f"{run_id}.log"
    wrapped = f"exec 2>&1; echo \"► {title} · started $(date '+%H:%M:%S')\"; {{ {cmd}\n}}; rc=$?; echo; " \
              f"if [ $rc = 0 ]; then echo \"✔ {title} · finished $(date '+%H:%M:%S')\"; " \
              f"else echo \"✖ {title} · failed (exit $rc) · $(date '+%H:%M:%S')\"; fi; echo $rc > {shlex.quote(str(log.with_suffix('.rc')))}"
    env = dict(os.environ, TERM="dumb", PAGER="cat", SYSTEMD_PAGER="", SYSMEDIC_TEST_VIA=via)
    p = subprocess.Popen(["bash", "-c", wrapped], stdout=open(log, "w"), stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                         start_new_session=True, env=env, cwd="/root")
    rec = {"run": run_id, "test": test, "title": title, "category": cat, "disk": disk, "minutes": minutes if needs == "minutes" else None,
           "pid": p.pid, "started": datetime.datetime.now().isoformat(timespec="seconds"), "log": str(log), "via": via}
    (runs_dir() / f"{run_id}.json").write_text(json.dumps(rec))
    if session:
        try:
            session.audit("tests", f"started {title}{(' ' + disk) if disk else ''} via {via} ({run_id})")
        except Exception:  # noqa: BLE001
            pass
    return rec


def stop(key):
    targets = [r for r in runs() if r["state"] == "running"] if key == "all" else [find_run(key)]
    stopped = []
    for r in targets:
        if not r or r["state"] != "running":
            continue
        try:
            os.killpg(r["pid"], signal.SIGTERM)
        except OSError:
            pass
        r["stopped"] = True
        rec = {k: v for k, v in r.items() if k not in ("state", "exit", "ended")}
        (runs_dir() / f"{r['run']}.json").write_text(json.dumps(rec))
        stopped.append(r["run"])
    return stopped


def tail(r, n=40):
    try:
        lines = Path(r["log"]).read_text(errors="replace").splitlines()
    except OSError:
        return ""
    return "\n".join(re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", l) for l in lines[-n:])


def opencode_commands():
    """OpenCode slash commands: one per test plus /tests, /full-check and /test-status (merged in at deploy)."""
    howto = ("Run it with the bash tool: `{start}`. Then call `sysmedic-tests wait {test} --timeout 540` "
             "(repeat while it says it's still running; for tests longer than ~30 minutes, tell the engineer it's "
             "running, that they can watch it with `sysmedic-tests log {test}` or on the phone dashboard, and stop "
             "waiting). When it finishes, read the output and explain the result in plain English: pass or fail, "
             "what's abnormal, and what to do next. Keep it short.")
    cmds = {}
    for t, (cat, title, what, _cmd, needs, est, person) in TESTS.items():
        start_cmd = f"sysmedic-tests start {t}" + (" --disk <DISK>" if needs == "disk" else "") + (" --minutes <N>" if needs == "minutes" else "")
        parts = [f"SysMedic {cat} test: **{title}** ({what}; about {est})."]
        if needs == "disk":
            parts.append("Test the customer's disk(s): run `sysmedic-tests disks` and use the one(s) listed "
                         "(if there are several and the engineer didn't say which, test each in turn). $ARGUMENTS")
        if needs == "minutes":
            parts.append("Duration in minutes: use the number in '$ARGUMENTS' if there is one, otherwise 5.")
        if person:
            parts.append(f"Before starting, tell the engineer what to do: {person}. Ask them afterwards what they saw or heard.")
        parts.append(howto.format(start=start_cmd, test=t))
        cmds[SLASH[t]] = {
            "description": f"{title}: {what} ({est})", "agent": "SysMedic", "template": " ".join(parts)}
    cmds["full-check"] = {"description": "Quick full check: health, scan, battery, network, Windows check-up (~5 min)", "agent": "SysMedic",
                          "template": "Run SysMedic's quick full check: start each of " + ", ".join(f"`sysmedic-tests start {t}`" for t in SUITES["full-check"])
                          + " one after another (wait for each with `sysmedic-tests wait TEST --timeout 540`). Then give one combined "
                          "summary: what's healthy, what's wrong (most urgent first) and the next steps."}
    cmds["tests"] = {"description": "List every hardware and software test SysMedic can run", "agent": "SysMedic",
                     "template": "Run `sysmedic-tests list` and show the engineer the tests as a short numbered menu "
                     "(name, what it shows, time). Mention the slash commands (e.g. /disk-test, /cpu-stress, /windows-checkup, "
                     "/full-check) and that the phone dashboard can run them too. Ask which to run."}
    cmds["test-status"] = {"description": "Show running and finished tests, with results", "agent": "SysMedic",
                           "template": "Run `sysmedic-tests status` and summarise: what's running (and for how long), and the "
                           "result of each finished test in one line."}
    return cmds


def menu():
    ids = list(TESTS)
    while True:
        print(f"\n{C['b']}  SysMedic tests{C['e']}   {C['d']}(read-only; results go into this visit's job report){C['e']}")
        for i, t in enumerate(ids, 1):
            v = TESTS[t]
            if i == 1 or v[0] != TESTS[ids[i - 2]][0]:
                print(f"\n  {C['b']}{v[0].capitalize()}{C['e']}")
            print(f"  {i:2}) {v[1]:30} {C['d']}{v[5]}{C['e']}" + (f"  {C['y']}(you: {v[6]}){C['e']}" if v[6] else ""))
        print(f"\n   s) Status of tests run this visit    x) Stop running tests    0) Back")
        print(f"  {C['d']}Full RAM test: reboot into MemTest86+ from the boot menu. The phone dashboard runs these too.{C['e']}")
        c = input("  Choose: ").strip().lower()
        if c in ("0", "", "q"):
            return
        if c == "s":
            os.system("sysmedic-tests status"); input("  Press Enter…"); continue
        if c == "x":
            print("  " + (", ".join(stop("all")) or "Nothing running.")); input("  Press Enter…"); continue
        if not c.isdigit() or not 1 <= int(c) <= len(ids):
            continue
        t = ids[int(c) - 1]
        v = TESTS[t]
        disk, minutes = "", None
        if v[4] == "disk":
            ds = disks()
            for j, d in enumerate(ds, 1):
                print(f"   {j}) {d['dev']:14} {d['size']:>8}  {d['model']} {d['tran']}")
            pick = input("  Disk number: ").strip()
            if not pick.isdigit() or not 1 <= int(pick) <= len(ds):
                continue
            disk = ds[int(pick) - 1]["dev"]
        if v[4] == "minutes":
            minutes = input("  Minutes [5]: ").strip() or "5"
        if v[6]:
            print(f"  {C['y']}You'll need to {v[6]}.{C['e']}")
        try:
            r = start(t, disk, minutes)
        except ValueError as e:
            print(f"  {e}"); input("  Press Enter…"); continue
        print(f"  Started {r['title']}. Showing its output live; Ctrl-C returns to the menu (the test keeps running).\n")
        try:
            subprocess.run(["bash", "-c", f"tail -n +1 -f {shlex.quote(r['log'])} & t=$!; "
                            f"while [ ! -e {shlex.quote(str(Path(r['log']).with_suffix('.rc')))} ]; do sleep 1; done; sleep 1; kill $t"])
            input("\n  Finished. Press Enter…")
        except KeyboardInterrupt:
            print("\n  (still running in the background: sysmedic-tests status)")


def main():
    a = sys.argv[1:]
    js = "--json" in a
    a = [x for x in a if x != "--json"]
    opt = lambda name, d=None: a[a.index(name) + 1] if name in a and a.index(name) + 1 < len(a) else d  # noqa: E731
    cmd = a[0] if a else "list"
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return
    if cmd == "catalogue":   # markdown, for the AI instructions (sysmedic-deploy)
        print("\n".join(f"- `{t}`: {v[1]} ({v[5]}): {v[2].rstrip('.')}." + (" Needs `--disk /dev/X` (a whole disk, never a partition)." if v[4] == "disk" else "")
                         + (" Optional `--minutes N`." if v[4] == "minutes" else "") for t, v in TESTS.items()))
        return
    if cmd == "opencode-commands":
        print(json.dumps(opencode_commands(), indent=2))
        return
    if os.geteuid() != 0:
        sys.exit("sysmedic-tests must run as root")
    if cmd == "menu":
        try:
            menu()
        except (KeyboardInterrupt, EOFError):
            print()
        return
    if cmd == "list":
        if js:
            print(json.dumps([{"id": t, "category": v[0], "title": v[1], "what": v[2], "needs": v[4], "estimate": v[5], "person": v[6]}
                              for t, v in TESTS.items()], indent=1))
            return
        ui = UI()
        print(ui.banner("Tests", f"{len(TESTS)} hardware and software tests · start one: sysmedic-tests start NAME"))
        for cat in ("hardware", "software"):
            print(ui.section(f"{cat.capitalize()}"))
            for t, v in TESTS.items():
                if v[0] == cat:
                    room = max(20, ui.width - 62 - (4 if v[6] else 0))
                    what = v[2] if len(v[2]) <= room else v[2][:room - 1].rstrip(" ,;:") + "…"
                    person = ui.c("warning", "  ●") if v[6] else ""
                    print(f"  {ui.c('accent', t.ljust(16))} {v[1][:30]:30} {ui.c('dim', v[5].rjust(9) + '  ' + what)}{person}")
        print("\n  " + ui.c("warning", "●") + ui.c("dim", " needs you at the laptop   ·   watch: sysmedic-tests watch NAME   ·   full RAM test: MemTest86+ (boot menu)"))
    elif cmd == "disks":
        ds = disks()
        print(json.dumps(ds) if js else "\n".join(f"  {d['dev']:14} {d['size']:>8}  {d['model']} {d['tran']}" for d in ds) or "  no disks to test")
    elif cmd == "start":
        try:
            r = start(a[1] if len(a) > 1 else "", opt("--disk", ""), opt("--minutes"), via=os.environ.get("SYSMEDIC_TESTS_VIA") or ("ai" if os.environ.get("SYSMEDIC_AI") else "console"))
        except (ValueError, IndexError) as e:
            sys.exit(f"  {e}")
        print(json.dumps(r) if js else f"  Started {r['title']} ({r['run']}). Watch: sysmedic-tests log {r['test']}")
    elif cmd == "watch":
        r = find_run(a[1] if len(a) > 1 else "latest")
        if not r:
            sys.exit("  no such test run (sysmedic-tests status)")
        rc = Path(r["log"]).with_suffix(".rc")
        try:
            subprocess.run(["bash", "-c", f"tail -n +1 -f {shlex.quote(r['log'])} & t=$!; "
                            f"while [ ! -e {shlex.quote(str(rc))} ]; do sleep 1; done; sleep 1; kill $t"])
        except KeyboardInterrupt:
            print("\n  (stopped watching; the test keeps running: sysmedic-tests status)")
            sys.exit(130)
        code = rc.read_text().strip()
        ui = UI()
        print("\n" + (ui.item("ok", f"{r['title']}: passed") if code == "0" else ui.item("fail", f"{r['title']}: FAILED (exit {code})")))
        sys.exit(0 if code == "0" else 1)
    elif cmd == "status":
        rs = runs()
        if len(a) > 1:
            rs = [r for r in rs if r["run"] == a[1] or r["test"] == a[1]][:1]
        if js:
            print(json.dumps(rs))
            return
        if not rs:
            print("  No tests run yet this visit. sysmedic-tests list")
        for r in rs:
            sev = {"running": "run", "passed": "ok"}.get(r["state"], "fail")
            print(UI().item(sev, f"{r['title']}{(' ' + r['disk']) if r.get('disk') else ''}  " + UI().c("dim", f"{r['state']} · {r['run']} · started {r['started'][11:19]}")))
    elif cmd == "wait":
        key = a[1] if len(a) > 1 else "latest"
        limit, t0 = int(opt("--timeout", 540)), time.time()
        while True:
            r = find_run(key)
            if not r:
                sys.exit(f"  no such test run: {key}")
            if r["state"] != "running" or time.time() - t0 > limit:
                break
            time.sleep(3)
        print(tail(r, 80))
        print(f"\n  [{r['title']}: {r['state']}" + ("" if r["state"] != "running" else f" — still running after {limit} s; wait again or check later") + "]")
    elif cmd == "log":
        r = find_run(a[1] if len(a) > 1 else "latest")
        print(tail(r, int(opt("-n", 60))) if r else "  no such test run")
    elif cmd == "stop":
        s = stop(a[1] if len(a) > 1 else "all")
        print(f"  Stopped: {', '.join(s)}" if s else "  Nothing running.")
    else:
        sys.exit(f"Unknown command '{cmd}'. Try: sysmedic-tests help")


if __name__ == "__main__":
    main()
