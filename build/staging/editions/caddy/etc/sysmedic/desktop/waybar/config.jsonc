// SysMedic desktop panel: launchers · open windows · live machine strip · back to the console
{
  "layer": "top", "position": "top", "height": 34, "spacing": 4,
  "modules-left": ["custom/brand", "custom/centre", "custom/ai", "custom/terminal", "custom/files", "custom/disks", "custom/menu"],
  "modules-center": ["wlr/taskbar"],
  "modules-right": ["temperature", "memory", "network", "clock", "custom/console"],
  "custom/brand":    {"format": "SYSMEDIC", "tooltip": false},
  "custom/centre":   {"format": "◈ Control Centre", "on-click": "sysmedic-control-centre", "tooltip-format": "scan, tests, BitLocker, notes, job report (Super+C)"},
  "custom/ai":       {"format": "✦ AI", "on-click": "foot --title 'SysMedic AI assistant' sysmedic-ai-launch", "tooltip-format": "the AI assistant this visit's consent allows (Super+A)"},
  "custom/terminal": {"format": "❯_", "on-click": "foot", "tooltip-format": "Terminal (Super+Return)"},
  "custom/files":    {"format": "▤", "on-click": "thunar /", "tooltip-format": "Files (Super+E)"},
  "custom/disks":    {"format": "⛁", "on-click": "gnome-disks", "tooltip-format": "Disks: customer disks stay write-protected"},
  "custom/menu":     {"format": "☰ Menu", "on-click": "foot --title 'SysMedic rescue menu' -e /opt/sysmedic/rescue-menu.sh", "tooltip-format": "every console tool"},
  "wlr/taskbar":     {"format": "{title:.16}", "all-outputs": true, "on-click": "activate", "on-click-middle": "close", "tooltip-format": "{title}"},
  "temperature":     {"format": "CPU {temperatureC}°C", "critical-threshold": 90, "format-critical": "CPU {temperatureC}°C ▲"},
  "memory":          {"format": "RAM {used:0.1f}/{total:0.0f} GB", "interval": 5},
  "network":         {"format-wifi": "◉ {essid}", "format-ethernet": "◉ wired", "format-disconnected": "○ offline", "tooltip-format": "{ifname} {ipaddr}"},
  "clock":           {"format": "{:%H:%M}", "tooltip-format": "{:%A %d %B %Y}"},
  "custom/console":  {"format": "⇦ Console", "on-click": "labwc --exit", "tooltip-format": "close the desktop and return to the rescue menu"}
}
