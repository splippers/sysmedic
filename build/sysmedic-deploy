#!/bin/bash
# sysmedic-deploy — install the shared SysMedic core (+ edition files) onto a drive.
#
#   ./sysmedic-deploy --caddy [/dev/sdX]   update the plugged-in caddy SSD in place
#   ./sysmedic-deploy --stick-image        rebuild the stick image only (sysmedic-v2.iso, stick-test.img)
#   ./sysmedic-deploy --stick [/dev/sdX]   rebuild and write the stick; its sessions are backed up and restored
#   ./sysmedic-deploy --version            print the version the shared core would get
#
# Source of truth: staging/shared/ (identical on both), staging/editions/<edition>/,
# staging/agent/{core,caddy,stick}.md. Both drives get the same version stamp when
# their shared core is the same, so /etc/sysmedic/version tells you if they're in step.
set -Eeuo pipefail
trap 'echo -e "\033[1;31mERROR:\033[0m deploy stopped at line $LINENO: $BASH_COMMAND" >&2' ERR
cd "$(dirname "$0")"
KIT=$PWD
ST=$KIT/staging
STICK_ROOT=$KIT/root
WORK=$(mktemp -d /tmp/sysmedic-deploy.XXXX)
trap 'cleanup' EXIT

say()  { echo -e "\033[1m==>\033[0m $*"; }
die()  { echo -e "\033[1;31mERROR:\033[0m $*" >&2; exit 1; }

MOUNTS=()
cleanup() {
    for ((i=${#MOUNTS[@]}-1; i>=0; i--)); do sudo umount "${MOUNTS[i]}" 2>/dev/null || true; done
    rm -rf "$WORK" 2>/dev/null || true
}
mnt() { sudo mount "$@"; MOUNTS+=("${@: -1}"); }

version() {
    local h
    # covers everything that ends up on the drives: shared files, AI instructions, package lists
    h=$(cd "$ST" && find shared agent packages obsolete.txt -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-8)
    # date of the last commit that touched the shared core (so identical cores get identical versions);
    # today's date only if there are uncommitted changes
    local d repo; repo=$(cd "$(realpath "$ST")/../.." && pwd)
    if git -C "$repo" diff --quiet HEAD -- build/staging/shared build/staging/agent build/staging/packages build/staging/obsolete.txt 2>/dev/null; then
        d=$(git -C "$repo" log -1 --format=%cd --date=format:%Y.%m.%d -- build/staging/shared build/staging/agent build/staging/packages build/staging/obsolete.txt 2>/dev/null)
    fi
    echo "${d:-$(date +%Y.%m.%d)}-$h"
}

host_disk() { lsblk -no PKNAME "$(findmnt -no SOURCE /)" | head -1; }

# install_tree ROOT EDITION → sets HOOKS_CHANGED=1 if any initramfs hook changed
install_tree() {
    local root=$1 ed=$2 before after v
    v=$(version)
    before=$(sudo sh -c "cat $root/etc/initramfs-tools/hooks/* $root/etc/initramfs-tools/conf.d/* 2>/dev/null; true" | md5sum)
    # Leftovers from older builds that break things (staging/obsolete.txt)
    grep -vE '^\s*(#|$)' "$ST/obsolete.txt" 2>/dev/null | while read -r f; do
        [ -e "$root/$f" ] && { sudo rm -f "$root/$f"; say "Removed obsolete /$f"; }
        sudo rmdir "$(dirname "$root/$f")" 2>/dev/null || true
    done
    sudo rsync -rlpt --chown=root:root --exclude=__pycache__ "$ST/shared/" "$root/"
    [ -d "$ST/editions/$ed" ] && sudo rsync -rlpt --chown=root:root --exclude=__pycache__ "$ST/editions/$ed/" "$root/"
    # AI instructions: shared core with this edition's toolkit section
    python3 - "$ST/agent/core.md" "$ST/agent/$ed.md" > "$WORK/agent.md" <<'EOF'
import sys
core, ed = open(sys.argv[1]).read(), open(sys.argv[2]).read()
print(core.replace("<!-- SYSMEDIC EDITION SECTION -->", ed.strip() + "\n\n---"), end="")
EOF
    python3 "$ST/shared/usr/local/bin/sysmedic-tests" catalogue > "$WORK/tests.md"
    python3 - "$WORK/agent.md" "$WORK/tests.md" <<'EOF'
import sys
p, t = sys.argv[1], open(sys.argv[2]).read().strip()
s = open(p).read()
assert "<!-- SYSMEDIC TESTS -->" in s, "core.md lost its <!-- SYSMEDIC TESTS --> marker"
open(p, "w").write(s.replace("<!-- SYSMEDIC TESTS -->", t))
EOF
    sudo install -D -o root -g root -m 644 "$WORK/agent.md" "$root/opt/sysmedic/SYSMEDIC-AGENT.md"
    # The documentation (repo docs/ + README) goes on the drive for offline reading: sysmedic-help
    local repo; repo=$(cd "$(realpath "$ST")/../.." && pwd)
    sudo rm -rf "$root/usr/local/share/doc/sysmedic"
    sudo install -D -o root -g root -m 644 "$repo/README.md" "$root/usr/local/share/doc/sysmedic/README.md"
    sudo rsync -rlpt --chown=root:root "$repo/docs/" "$root/usr/local/share/doc/sysmedic/docs/"
    # No customer Wi-Fi passwords on the drive: networks now live in RAM (NetworkManager conf.d), and any
    # saved before that are removed
    local wifi_saved
    wifi_saved=$(sudo grep -lsE '^(psk|password|wep-key[0-9])=' "$root"/etc/NetworkManager/system-connections/* 2>/dev/null || true)
    if [ -n "$wifi_saved" ]; then
        echo "$wifi_saved" | while read -r f; do sudo rm -f "$f"; done
        say "Removed $(echo "$wifi_saved" | wc -l) saved Wi-Fi network(s) with passwords from the drive"
    fi
    # Ubuntu's NetworkManager also mirrors networks into netplan (/etc/netplan/90-NM-<uuid>.yaml)
    local np
    np=$(sudo grep -lsE '^\s*password:' "$root"/etc/netplan/90-NM-*.yaml* 2>/dev/null || true)
    if [ -n "$np" ]; then
        echo "$np" | while read -r f; do sudo rm -f "$f"; done
        say "Removed $(echo "$np" | wc -l) netplan Wi-Fi profile(s) with passwords from the drive"
    fi
    sudo grep -lsE '^\s*password:' "$root"/etc/netplan/* >/dev/null 2>&1 && \
        say "WARNING: a password is still stored in $root/etc/netplan — check it"
    # OpenCode slash commands for every test (/disk-test, /cpu-stress, /windows-checkup, /full-check, /tests…),
    # generated from sysmedic-tests' catalogue so the menu always matches the tests
    python3 "$ST/shared/usr/local/bin/sysmedic-tests" opencode-commands > "$WORK/commands.json"
    sudo python3 - "$root/root/.config/opencode/opencode.json" "$WORK/commands.json" <<'PY'
import json, sys
from collections import OrderedDict
p = sys.argv[1]; c = json.load(open(p), object_pairs_hook=OrderedDict)
c["command"] = json.load(open(sys.argv[2]))
json.dump(c, open(p, "w"), indent=2)
PY
    # OpenCode as SysMedic: logo, examples, tips, and tool output fully expanded (no mouse on the console)
    local oc
    for oc in "$root/usr/local/bin/opencode" "$root/root/.opencode/bin/opencode"; do
        [ -f "$oc" ] && [ ! -L "$oc" ] && { sudo python3 "$repo/build/opencode-brand.py" "$oc" | sed 's|^|    |' || say "WARNING: couldn't brand $oc (OpenCode changed?); it still works, unbranded"; }
    done
    # Known-good copies for sysmedic-ai-repair (after branding, so a restore keeps the SysMedic changes)
    local good=$root/usr/local/share/sysmedic/opencode
    sudo rm -rf "$good"; sudo mkdir -p "$good/config"
    sudo cp -a "$root/root/.config/opencode/opencode.json" "$root/root/.config/opencode/tui.json" \
               "$root/root/.config/opencode/cli.json" "$root/root/.config/opencode/themes" "$good/config/"
    sudo cp "$ST/shared/root/.local/state/opencode/kv.json" "$good/kv.json"
    if [ -f "$root/usr/local/bin/opencode" ] && [ ! -L "$root/usr/local/bin/opencode" ]; then
        sudo cp "$root/usr/local/bin/opencode" "$good/opencode"
        (cd "$root/usr/local/bin" && sudo sha256sum opencode) | sudo tee "$good/opencode.sha256" >/dev/null
    fi
    sudo ln -sf sysmedic-guard "$root/usr/local/sbin/sysmedic-lock"
    sudo ln -sf sysmedic-guard "$root/usr/local/sbin/sysmedic-unlock"
    sudo ln -sf ambulance "$root/usr/local/bin/menu"
    sudo ln -sf sysmedic-scan "$root/usr/local/bin/scan"
    sudo mkdir -p "$root/etc/systemd/system/multi-user.target.wants"
    sudo ln -sf /etc/systemd/system/sysmedic-transcript.service "$root/etc/systemd/system/multi-user.target.wants/sysmedic-transcript.service"
    sudo grep -q 'sysmedic/audit.sh' "$root/root/.bashrc" 2>/dev/null || \
        printf '\n# SysMedic: log console commands to the session audit trail\n. /etc/sysmedic/audit.sh\n' | sudo tee -a "$root/root/.bashrc" >/dev/null
    echo "$ed" | sudo tee "$root/etc/sysmedic/edition" >/dev/null
    echo "$v" | sudo tee "$root/etc/sysmedic/version" >/dev/null
    after=$(sudo sh -c "cat $root/etc/initramfs-tools/hooks/* $root/etc/initramfs-tools/conf.d/* 2>/dev/null; true" | md5sum)
    HOOKS_CHANGED=0; [ "$before" = "$after" ] || HOOKS_CHANGED=1
    DEPLOYED_VERSION=$v
    say "Installed SysMedic $ed edition v$v into $root"
}

chroot_run() {   # chroot_run ROOT CMD...
    local root=$1; shift
    for d in dev proc sys; do mnt --bind "/$d" "$root/$d"; done
    sudo chroot "$root" "$@"
    mountpoint -q "$root/sys/firmware/efi/efivars" && sudo umount "$root/sys/firmware/efi/efivars"
    for d in sys proc dev; do sudo umount "$root/$d"; MOUNTS=("${MOUNTS[@]/$root\/$d}"); done
}

# with_net_chroot ROOT CMD...: chroot with network, and services prevented from starting
with_net_chroot() {
    local root=$1; shift
    for d in dev dev/pts proc sys; do mnt --bind "/$d" "$root/$d"; done
    sudo mv "$root/etc/resolv.conf" "$root/etc/resolv.conf.sysmedic-deploy"
    sudo cp /etc/resolv.conf "$root/etc/resolv.conf"
    printf '#!/bin/sh\nexit 101\n' | sudo tee "$root/usr/sbin/policy-rc.d" >/dev/null; sudo chmod 755 "$root/usr/sbin/policy-rc.d"
    local rc=0
    sudo chroot "$root" "$@" || rc=$?
    sudo rm -f "$root/usr/sbin/policy-rc.d" "$root/etc/resolv.conf"
    sudo mv "$root/etc/resolv.conf.sysmedic-deploy" "$root/etc/resolv.conf"
    mountpoint -q "$root/sys/firmware/efi/efivars" && sudo umount "$root/sys/firmware/efi/efivars"
    for d in sys proc dev/pts dev; do sudo umount "$root/$d"; MOUNTS=("${MOUNTS[@]/$root\/$d}"); done
    return $rc
}

# install_packages ROOT EDITION: install anything missing from packages/shared.txt + packages/EDITION.txt
install_packages() {
    local root=$1 ed=$2 want missing=() p
    want=$( { cat "$ST/packages/shared.txt"; cat "$ST/packages/$ed.txt" 2>/dev/null || true; } | sed 's/#.*//' | tr -s ' \t' '\n' | grep -v '^$' | sort -u)
    for p in $want; do
        sudo chroot "$root" dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'ok installed' || missing+=("$p")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        say "Installing ${#missing[@]} package(s) on the $ed edition: ${missing[*]}"
        # Fail the deploy on apt errors instead of shipping without the packages
        with_net_chroot "$root" bash -c "export DEBIAN_FRONTEND=noninteractive; apt-get update -qq || exit 1
            out=\$(apt-get install -y -q --no-install-recommends ${missing[*]} 2>&1); rc=\$?
            echo \"\$out\" | grep -E '^E:|newly installed'; apt-get clean; exit \$rc" \
            || die "Package install failed on the $ed edition (see the apt error above; apt-get check in the chroot)"
        [ "$ed" = stick ] && sudo find "$root/var/lib/apt/lists" -type f ! -name lock -delete
    else
        say "All $(echo "$want" | wc -w) listed packages already present on the $ed edition"
    fi
    for p in $(sed 's/#.*//' "$ST/packages/mask.txt" | tr -s ' \t' '\n' | grep -v '^$'); do
        sudo ln -sf /dev/null "$root/etc/systemd/system/$( [[ $p == *.* ]] && echo "$p" || echo "$p.service")"
    done
}

# ── Caddy ──────────────────────────────────────────────────────────────────

find_caddy() {   # a USB disk (not this PC's) whose ext4 root carries SysMedic's caddy layout
    local hd d p ed
    hd=$(host_disk)
    for d in $(lsblk -dno NAME,TRAN | awk '$2=="usb"{print $1}'); do
        [ "$d" = "$hd" ] && continue
        for p in $(lsblk -lno NAME,FSTYPE "/dev/$d" | awk '$2=="ext4"{print $1}'); do
            sudo mount -o ro,noload "/dev/$p" "$WORK/probe" 2>/dev/null || continue
            ed=$(cat "$WORK/probe/etc/sysmedic/edition" 2>/dev/null || true)
            [ "$ed" = caddy ] || { [ -d "$WORK/probe/srv/sysmedic" ] && [ -f "$WORK/probe/opt/sysmedic/rescue-menu.sh" ] && ed=caddy; }
            sudo umount "$WORK/probe"
            [ "$ed" = caddy ] && { echo "/dev/$d"; return; }
        done
    done
}

# install_caddy_extras ROOT: what only the caddy has: the full toolkit in /opt/sysmedic (repo root),
# root's shell setup, the persistence service, and only the Qwen models in the Ollama store
install_caddy_extras() {
    local root=$1 repo pruned
    repo=$(cd "$(realpath "$ST")/../.." && pwd)
    sudo rsync -rlpt --chown=root:root --exclude=.git --exclude=build --exclude=docs --exclude='*.pyc' \
        "$repo/" "$root/opt/sysmedic/"
    sudo install -o root -g root -m 755 "$repo/usr-local-bin/sysmedic" "$repo/usr-local-bin/sysmedic-menu" "$root/usr/local/bin/"
    sudo install -o root -g root -m 644 "$repo/dotfiles/.bashrc" "$repo/dotfiles/.tmux.conf" "$root/root/"
    sudo grep -q 'sysmedic/audit.sh' "$root/root/.bashrc" || \
        printf '\n# SysMedic: log console commands to the session audit trail\n. /etc/sysmedic/audit.sh\n' | sudo tee -a "$root/root/.bashrc" >/dev/null
    sudo mkdir -p "$root/etc/systemd/system/sysinit.target.wants"
    sudo ln -sf /etc/systemd/system/sysmedic-persist.service "$root/etc/systemd/system/sysinit.target.wants/sysmedic-persist.service"
    # Offline AI: Qwen only (anything else in the store is removed, with blobs no Qwen manifest uses)
    pruned=$(sudo python3 - "$root/srv/sysmedic/ollama/models" <<'PY'
import json, os, sys, shutil
base = sys.argv[1]; lib = os.path.join(base, "manifests/registry.ollama.ai/library")
if not os.path.isdir(lib):
    sys.exit()
removed, used = [], set()
for name in os.listdir(lib):
    if name != "qwen2.5":
        shutil.rmtree(os.path.join(lib, name)); removed.append(name); continue
    for tag in os.listdir(os.path.join(lib, name)):
        m = json.load(open(os.path.join(lib, name, tag)))
        used |= {m["config"]["digest"].replace(":", "-")} | {l["digest"].replace(":", "-") for l in m["layers"]}
if removed:
    for b in os.listdir(os.path.join(base, "blobs")):
        if b not in used:
            os.remove(os.path.join(base, "blobs", b))
print(" ".join(removed))
PY
)
    [ -n "$pruned" ] && say "Removed offline models other than Qwen: $pruned"
    return 0
}

deploy_caddy() {
    local dev=${1:-} root=$WORK/caddy esp
    mkdir -p "$WORK/probe" "$root"
    [ -n "$dev" ] || dev=$(find_caddy)
    [ -n "$dev" ] || die "No caddy found (plug it in, or give the device: --caddy /dev/sdX)"
    [ "${dev#/dev/}" != "$(host_disk)" ] || die "$dev is this PC's own disk"
    say "Caddy: $dev ($(lsblk -dno MODEL,SERIAL "$dev" | xargs))"
    local mp; mp=$(lsblk -lnpo MOUNTPOINTS "$dev" | grep -v '^$' | head -1 || true)
    [ -z "$mp" ] || die "$dev is mounted at $mp: unmount it first (sudo umount $mp)"
    local rootp; rootp=$(lsblk -lpno NAME,FSTYPE "$dev" | awk '$2=="ext4"{print $1; exit}')
    esp=$(lsblk -lpno NAME,FSTYPE "$dev" | awk '$2=="vfat"{print $1; exit}')
    mnt "$rootp" "$root"
    [ -n "$esp" ] && mnt "$esp" "$root/boot/efi"
    local grub_before; grub_before=$(sudo sh -c "cat $root/etc/default/grub $root/etc/default/grub.d/* 2>/dev/null; true" | md5sum)
    install_tree "$root" caddy
    install_caddy_extras "$root"
    install_packages "$root" caddy
    if [ "$HOOKS_CHANGED" = 1 ]; then
        say "An initramfs hook changed: rebuilding the caddy's initramfs"
        chroot_run "$root" update-initramfs -u -k all
    fi
    if [ "$grub_before" != "$(sudo sh -c "cat $root/etc/default/grub $root/etc/default/grub.d/* 2>/dev/null; true" | md5sum)" ]; then
        say "Boot menu settings changed: updating GRUB"
        chroot_run "$root" update-grub 2>&1 | grep -E '^Found|done' || true
    fi
    sync
    say "Caddy updated. Safe to unplug once this finishes."
}

# ── Stick ──────────────────────────────────────────────────────────────────

build_stick_image() {
    local kv
    install_tree "$STICK_ROOT" stick
    install_packages "$STICK_ROOT" stick
    sudo rm -f "$STICK_ROOT/opt/sysmedic/menu.sh"      # the stick uses rescue-menu.sh like the caddy
    if [ "$HOOKS_CHANGED" = 1 ]; then
        kv=$(ls "$STICK_ROOT/usr/lib/modules" | sort -V | tail -1)
        say "An initramfs hook changed: rebuilding the stick's initrd for $kv"
        chroot_run "$STICK_ROOT" update-initramfs -c -k "$kv"
        sudo cp "$STICK_ROOT/boot/initrd.img-$kv" "$KIT/kernel/initrd"
        sudo rm -f "$STICK_ROOT"/boot/initrd.img*
    fi
    say "Building the stick ISO"
    ./build-iso.sh | tail -2
    rm -f stick-test.img; truncate -s "$(sudo blockdev --getsize64 "${STICK_DEV:-/dev/null}" 2>/dev/null || echo 15376318464)" stick-test.img
    ./make-stick.sh stick-test.img | tail -1
    say "Stick image ready: sysmedic-v2.iso, stick-test.img (test with QEMU before writing)"
}

find_stick() {   # a USB disk with the SysMedic ISO and a persistence partition
    local hd d
    hd=$(host_disk)
    for d in $(lsblk -dno NAME,TRAN | awk '$2=="usb"{print $1}'); do
        [ "$d" = "$hd" ] && continue
        lsblk -nro LABEL "/dev/$d" | grep -qx SYSMEDIC_2404 && lsblk -nro LABEL "/dev/$d" | grep -qx FOG_AMB_PERSIST && { echo "/dev/$d"; return; }
    done
}

deploy_stick() {
    local dev=${1:-} persist tarball n
    [ -n "$dev" ] || dev=$(find_stick)
    [ -n "$dev" ] || die "No SysMedic stick found (give the device: --stick /dev/sdX)"
    [ "${dev#/dev/}" != "$(host_disk)" ] || die "$dev is this PC's own disk"
    STICK_DEV=$dev
    say "Stick: $dev ($(lsblk -dno MODEL,SERIAL,SIZE "$dev" | xargs))"
    build_stick_image
    for p in $(lsblk -lpno NAME "$dev" | tail -n +2); do findmnt -rno TARGET -S "$p" >/dev/null && sudo umount "$p"; done
    persist=$(lsblk -lpno NAME,LABEL "$dev" | awk '$2=="FOG_AMB_PERSIST"{print $1; exit}')
    mkdir -p "$KIT/stick-sessions-backup" "$WORK/persist"
    tarball=$KIT/stick-sessions-backup/stick-persist-$(date +%Y%m%d-%H%M%S).tar
    if [ -n "$persist" ]; then
        mnt -o ro "$persist" "$WORK/persist"
        sudo tar -C "$WORK/persist" -cpf "$tarball" $(cd "$WORK/persist" && sudo ls -d sessions logs backups private transcripts claude-review 2>/dev/null) 2>/dev/null || true
        sudo umount "$WORK/persist"; MOUNTS=("${MOUNTS[@]/$WORK\/persist}")
        sudo chmod 600 "$tarball"
        n=$(sudo tar -tf "$tarball" | grep -c '^sessions/[^/]*/$' || true)
        say "Backed up the stick's data ($n session(s)) → $tarball"
    fi
    say "Writing the stick (about 15–20 minutes on a USB 2.0 stick)"
    ./make-stick.sh "$dev" | tail -1
    say "Verifying the written image against the tested one"
    local size pstart; size=$(stat -c %s sysmedic-v2.iso)
    # Stop where the persistence partition starts: it can overlap the ISO's last sectors (xorriso's spare
    # partition table, dead once make-stick moves the GPT to the end of the disk), and it's freshly made each time.
    pstart=$(( $(cat "/sys/class/block/$(lsblk -lno NAME,PARTN "$dev" | awk '$2==4{print $1}')/start" 2>/dev/null || echo 0) * 512 ))
    [ "$pstart" -gt 1536 ] && [ "$pstart" -lt "$size" ] && size=$pstart
    # sectors 0-2 hold the partition tables, which get a fresh GUID for the persistence partition
    if ! sudo cmp -s -n $((size - 1536)) -i 1536 "$dev" stick-test.img; then die "Verification failed: the stick doesn't match the tested image"; fi
    say "Verified."
    if [ -n "$persist" ] && [ -s "$tarball" ]; then
        persist=$(lsblk -lpno NAME,LABEL "$dev" | awk '$2=="FOG_AMB_PERSIST"{print $1; exit}')
        mnt "$persist" "$WORK/persist"
        sudo tar -C "$WORK/persist" -xpf "$tarball"
        sudo chmod 700 "$WORK/persist/private" 2>/dev/null || true
        sync; sudo umount "$WORK/persist"; MOUNTS=("${MOUNTS[@]/$WORK\/persist}")
        say "Restored the stick's sessions."
    fi
    say "Stick updated: SysMedic stick edition v$DEPLOYED_VERSION. Safe to unplug."
}

case "${1:-}" in
    --caddy)       deploy_caddy "${2:-}" ;;
    --stick-image) build_stick_image ;;
    --stick)       deploy_stick "${2:-}" ;;
    --version)     version ;;
    *)             sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
