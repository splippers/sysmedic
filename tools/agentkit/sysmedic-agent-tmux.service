[Unit]
Description=SysMedic agent workspace (tmux session "agent": swarm poller + engineer shell)
After=network-online.target

[Service]
Type=forking
ExecStart=%h/.local/share/sysmedic-agent/session.sh
ExecStop=-/usr/bin/tmux kill-session -t agent
Restart=always
RestartSec=30
KillMode=control-group

[Install]
WantedBy=default.target
