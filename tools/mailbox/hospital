#!/usr/bin/env python3
"""hospital — the engineer's/Claude's side of the SysMedic mailbox.

  hospital pair NAME [--host IP]   make a token for a rescue computer; prints the pairing code to type into it
  hospital join-code [CODE|off]    the short code rescue computers type to join the swarm (shown, or set)
  hospital machines                who is paired, and when they last wrote
  hospital inbox [--all]           unread messages from the machines (--all: everything)
  hospital watch [SECONDS]         wait for a new message and print it (exit 0 on a message, 3 on timeout)
  hospital reply NAME TEXT...      answer a machine (or read the text from stdin with -)
  hospital revoke NAME             cancel a machine's token
  hospital serve                   run the server in the foreground
"""
import base64
import hashlib
import json
import os
import re
import secrets
import ssl
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import server as S  # noqa: E402

DIR = S.DIR


def fingerprint():
    der = ssl.PEM_cert_to_DER_cert((DIR / "cert.pem").read_text())
    return hashlib.sha256(der).hexdigest()


def save_machines(m):
    DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    p = DIR / "machines.json"
    p.write_text(json.dumps(m, indent=1))
    os.chmod(p, 0o600)


def cmd_pair(a):
    if not a:
        sys.exit("usage: hospital pair NAME [--host IP]")
    name = a[0]
    host = a[a.index("--host") + 1] if "--host" in a else (subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split() or ["127.0.0.1"])[0]
    if not (DIR / "cert.pem").exists():
        sys.exit("start the server once first (hospital serve) so it can make its certificate")
    token = secrets.token_urlsafe(24)
    m = S.machines()
    m[name] = {"hash": S.h(token), "created": time.strftime("%Y-%m-%d %H:%M"), "revoked": False}
    save_machines(m)
    blob = base64.urlsafe_b64encode(json.dumps({"u": f"https://{host}:{os.environ.get('MAILBOX_PORT', '8470')}", "f": fingerprint(), "t": token, "n": name}).encode()).decode()
    print(f"Paired '{name}'. On that rescue computer (Alt+F2 console), run:\n\n  sysmedic-hospital pair\n\nand paste this code:\n\n  H1.{blob}\n")
    print("The code holds the token: type it only on that machine, not into any chat.")
    port = os.environ.get("MAILBOX_PORT", "8470")
    print(f"\nMachine without the program yet (not redeployed)? On it, as root, check the hash matches before running:\n"
          f"  curl -sk https://{host}:{port}/client -o /usr/local/bin/sysmedic-hospital && sha256sum /usr/local/bin/sysmedic-hospital && chmod +x /usr/local/bin/sysmedic-hospital\n"
          f"  expected: {S.client_sha()}")


def cmd_join_code(a):
    f = DIR / "joincode.txt"
    if a and a[0] == "off":
        f.unlink(missing_ok=True)
        return print("Joining switched off.")
    if a:
        if not re.fullmatch(r"[A-Za-z0-9]{2,16}", a[0]):
            sys.exit("the code is 2-16 letters or digits")
        f.write_text(a[0])
        os.chmod(f, 0o600)
    elif not f.exists():
        f.write_text("%04d" % secrets.randbelow(10000))
        os.chmod(f, 0o600)
    port = os.environ.get("MAILBOX_PORT", "8470")
    print(f"Join code: {f.read_text().strip()}\n\nOn a rescue computer (Alt+F2 console):  sysmedic-hospital join {f.read_text().strip()}\n"
          f"It finds this PC by itself on the same network, names itself by its Service Tag and gets swarm-only access.\n"
          f"Change it:  hospital join-code NEWCODE     Switch off:  hospital join-code off\n"
          f"Not redeployed yet? Fetch the program first (check the hash {S.client_sha()[:16]}…):\n"
          f"  curl -sk https://{(subprocess.run(['hostname', '-I'], capture_output=True, text=True).stdout.split() or ['HOST'])[0]}:{port}/client -o /usr/local/bin/sysmedic-hospital && chmod +x /usr/local/bin/sysmedic-hospital")


def cmd_machines(_):
    last = {}
    for m in S.messages():
        if m["dir"] == "in":
            last[m["machine"]] = m["ts"]
    for n, m in S.machines().items():
        print(f"{n:<20} {'REVOKED' if m.get('revoked') else 'active ':<8} {m.get('scope', 'full'):<6} paired {m['created']}  last message {last.get(n, '-')}")


def seen_file():
    return DIR / "seen"


def seen():
    try:
        return int(seen_file().read_text())
    except (OSError, ValueError):
        return 0


def show(m):
    print(f"── #{m['id']} {m['ts']} · {m['machine']} · {m.get('kind', '')}\n{m['text']}\n")


def cmd_inbox(a):
    s = 0 if "--all" in a else seen()
    new = [m for m in S.messages() if m["dir"] == "in" and m["id"] > s]
    for m in new:
        show(m)
    if new:
        seen_file().write_text(str(new[-1]["id"]))
    elif "--all" not in a:
        print("(no new messages)")


def cmd_watch(a):
    end = time.time() + (int(a[0]) if a else 3500)
    while time.time() < end:
        if any(m["dir"] == "in" and m["id"] > seen() for m in S.messages()):
            return cmd_inbox([])
        time.sleep(3)
    sys.exit(3)


def cmd_reply(a):
    if len(a) < 2:
        sys.exit("usage: hospital reply NAME TEXT...")
    name = a[0]
    if name not in S.machines():
        sys.exit(f"no machine '{name}' (hospital machines)")
    text = sys.stdin.read() if a[1:] == ["-"] else " ".join(a[1:])
    m = S.append({"dir": "out", "machine": name, "text": text.strip()})
    print(f"sent #{m['id']} to {name}")


def cmd_swarm(a):
    """swarm open TITLE [-f BRIEF_FILE | BRIEF...] | board [SINCE] | say TEXT | close | agents"""
    sub = a[0] if a else ""
    tf = DIR / "swarm-topic.json"
    if sub == "open":
        if len(a) < 2:
            sys.exit("usage: hospital swarm open TITLE [-f BRIEF_FILE | BRIEF text...]")
        title, rest = a[1], a[2:]
        brief = Path(rest[1]).read_text() if rest[:1] == ["-f"] else " ".join(rest) or title
        bad = S.why_refused(title + " " + brief)
        if bad:
            sys.exit(f"the brief contains {bad}: a brainstorm topic must be free of customer and machine data")
        old = S.swarm_topic()
        tf.write_text(json.dumps({"id": (old or {}).get("id", 0) + 1, "title": title, "brief": brief.strip(), "status": "open",
                                  "opened": time.strftime("%Y-%m-%d %H:%M")}))
        os.chmod(tf, 0o600)
        print(f"Brainstorm #{S.swarm_topic()['id']} open: {title}")
    elif sub == "board":
        t = S.swarm_topic()
        if not t:
            return print("(no brainstorm yet)")
        since = int(a[1]) if len(a) > 1 else 0
        print(f"# {t['title']}  [{t['status']}]\n{t['brief']}\n")
        for m in S.swarm_posts():
            if m["id"] > since:
                print(f"#{m['id']} {m['ts']} {m['agent']}" + (f" → re #{m['reply_to']}" if m["reply_to"] else "") + f"\n{m['text']}\n")
    elif sub == "say":
        S.swarm_add("HOSPITAL", " ".join(a[1:]))
        print("posted")
    elif sub == "close":
        t = S.swarm_topic()
        if t:
            t["status"] = "closed"
            tf.write_text(json.dumps(t))
        print("closed")
    elif sub == "agents":
        counts = {}
        for m in S.swarm_posts():
            counts[m["agent"]] = counts.get(m["agent"], 0) + 1
        print("\n".join(f"{k:<14}{v} post(s)" for k, v in counts.items()) or "(nobody has posted)")
    elif sub == "watch":
        last = max([m["id"] for m in S.swarm_posts()] or [0])
        end = time.time() + (int(a[1]) if len(a) > 1 else 3500)
        while time.time() < end:
            if max([m["id"] for m in S.swarm_posts()] or [0]) > last:
                return cmd_swarm(["board", str(last)])
            time.sleep(3)
        sys.exit(3)
    else:
        print(cmd_swarm.__doc__)


def cmd_revoke(a):
    m = S.machines()
    if not a or a[0] not in m:
        sys.exit("usage: hospital revoke NAME")
    m[a[0]]["revoked"] = True
    save_machines(m)
    print("revoked")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, a = sys.argv[1], sys.argv[2:]
    if cmd == "serve":
        return S.main()
    fn = globals().get("cmd_" + cmd.replace("-", "_"))
    if not fn:
        sys.exit(__doc__)
    fn(a)


if __name__ == "__main__":
    main()
