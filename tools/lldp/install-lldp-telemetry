#!/usr/bin/env python3
"""install-lldp-telemetry [-p PORT] [--remove] [--dry-run] [USER@]HOST...

Put the LLDP telemetry broadcaster on one of the engineer's own computers (needs SSH and passwordless sudo there):
  * lldpd is installed with apt if it is missing (an existing lldpd and its configuration are left as they are);
  * /usr/local/sbin/sysmedic-lldp-telemetry plus a systemd service and a 30-second timer refresh what lldpd announces;
  * --remove stops and deletes the timer, service and script (lldpd itself stays).
Nothing else on the host is touched. Host keys are checked as usual: a changed key stops the install for that host.
"""
import subprocess
import sys
import zlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
SERVICE = """[Unit]
Description=Refresh the telemetry SysMedic announces through lldpd
After=lldpd.service
Wants=lldpd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sysmedic-lldp-telemetry
Nice=10
"""
TIMER = """[Unit]
Description=Refresh LLDP telemetry every 30 seconds

[Timer]
OnBootSec=20
OnUnitActiveSec=30
AccuracySec=5

[Install]
WantedBy=timers.target
"""
REMOTE = r'''
set -e
S="sudo -n"
if [ "$REMOVE" = 1 ]; then
  $S systemctl disable --now sysmedic-lldp-telemetry.timer 2>/dev/null || true
  $S rm -f /etc/systemd/system/sysmedic-lldp-telemetry.service /etc/systemd/system/sysmedic-lldp-telemetry.timer /usr/local/sbin/sysmedic-lldp-telemetry
  $S systemctl daemon-reload
  $S lldpcli configure lldp custom-tlv clear 2>/dev/null || true
  echo removed; exit 0
fi
command -v lldpd >/dev/null 2>&1 || { command -v apt-get >/dev/null || { echo "no lldpd and no apt-get: not installed"; exit 3; }; $S env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq lldpd >/dev/null; }
$S systemctl enable --now lldpd >/dev/null 2>&1 || true
$S install -m 0755 /tmp/sysmedic-lldp-telemetry.$$ /usr/local/sbin/sysmedic-lldp-telemetry
$S install -m 0644 /tmp/sysmedic-lldp-telemetry.service.$$ /etc/systemd/system/sysmedic-lldp-telemetry.service
$S install -m 0644 /tmp/sysmedic-lldp-telemetry.timer.$$ /etc/systemd/system/sysmedic-lldp-telemetry.timer
rm -f /tmp/sysmedic-lldp-telemetry*.$$
$S systemctl daemon-reload
$S systemctl enable --now sysmedic-lldp-telemetry.timer >/dev/null
$S /usr/local/sbin/sysmedic-lldp-telemetry
echo "installed; announcing: $(/usr/local/sbin/sysmedic-lldp-telemetry --print | head -1)"
'''


def run(host, port, remove, dry):
    ssh = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8"] + (["-p", port] if port else []) + [host]
    scp = ["scp", "-q", "-o", "BatchMode=yes"] + (["-P", port] if port else [])
    if dry:
        print(f"{host}: would {'remove' if remove else 'install lldpd if missing, the script, service and 30 s timer'}")
        return 0
    tag = str(abs(zlib.crc32(host.encode())) % 100000)
    if not remove:
        tmp = {"sysmedic-lldp-telemetry": (HERE / "sysmedic-lldp-telemetry").read_text(),
               "sysmedic-lldp-telemetry.service": SERVICE, "sysmedic-lldp-telemetry.timer": TIMER}
        for n, body in tmp.items():
            r = subprocess.run(ssh + [f"cat > /tmp/{n}.{tag}"], input=body, text=True, capture_output=True)
            if r.returncode:
                print(f"{host}: could not copy files: {r.stderr.strip()[:200]}")
                return 1
    r = subprocess.run(ssh + [f"REMOVE={1 if remove else 0} bash -s"], input=REMOTE.replace("$$", tag), text=True, capture_output=True)
    print(f"{host}: {(r.stdout.strip().splitlines() or [''])[-1] or r.stderr.strip()[:300]}")
    return r.returncode


def main():
    a = sys.argv[1:]
    port = a[a.index("-p") + 1] if "-p" in a else ""
    hosts = [x for i, x in enumerate(a) if not x.startswith("-") and (i == 0 or a[i - 1] != "-p")]
    if not hosts or "-h" in a:
        print(__doc__)
        return 2
    return max(run(h, port, "--remove" in a, "--dry-run" in a) for h in hosts)


if __name__ == "__main__":
    sys.exit(main())
